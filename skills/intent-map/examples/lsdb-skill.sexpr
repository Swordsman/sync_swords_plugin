(intent-map "lsdb skill"
  (goal G "lsdb as a plugin skill: artifact databases read and written from code, shared by many projects, so storage I/O doesn't burn tokens (Joe)")
  (need N1 "I/O happens in code; only what's asked for reaches the context (Joe)" :serves G :group "core")
  (need N2 "usable by intent maps, memory-structuring, littlewing and other projects (Joe)" :serves G :group "consumers")
  (need N3 "SKILL.md is a concise instruction manual for the script and points at it (Joe)" :serves G :group "core")
  (need N4 "look lsdb over and revise what needs it (Joe)" :serves G :group "core")
  (need N5 "one giant intent-map artifact that correlates projects, builds, ideas and concepts (Joe)" :serves G :group "consumers")
  (need N6 "undocumented endpoint: fail loudly, say what to do instead" :serves G :group "core")
  (solution S1 "lsdb split into small modules (ids, transport, verbs, cli) behind a thin scripts/lsdb.py + skills/lsdb/SKILL.md: verbs, CLI, exit codes, limits, library use; credited in CLAUDE.md skill sources" :meets (N2 N3) :status built :group "core")
  (solution S2 "revise: add the server's batch and str_replace verbs (both exist; arg shapes to confirm on a live store)" :meets (N1 N4) :status built :group "core")
  (solution S3 "revise: quiet CLI. --out DIR writes docs as files and prints one summary line; --ids lists ids only" :meets (N1 N4) :status built :group "core")
  (solution S4 "revise: retry with backoff on no reply, 429 and 5xx; everything else fails at once with the body" :meets (N4 N6) :status built :group "core")
  (solution S5 "SKILL.md: Claude creates the store by publishing a page with the Artifact tool, capabilities declaring db (owner-only write rules); lsdb then operates on it. Optional base page template (db wiring + a read-only collection browser) that pages like the giant intent map extend" :meets (N2 N3) :status built :group "core")
  (solution S6 "consumers later, each its own change: intent-map writes its graph to a store (one artifact, a collection per project; 25k-doc cap per artifact), memory-structuring and littlewing point at the skill" :meets (N2 N5) :status not-built :group "consumers")
  (test T1 "offline unit tests: id parsing, query args, exit codes 1 and 3, --out summary line" :tests (S1 S3))
  (test T2 "live round-trip on a store: set, get, update, query, str_replace, batch, delete" :tests (S2 S5))
  (test T3 "a forced 503/no-reply retries then exits 2 with the body" :tests S4))
