(intent-map "Artifact-db memory store"
  (project "lsdb")
  (goal G "an additional memory store, flexible and able to hold large amounts of data between sessions, used through code so I/O doesn't burn tokens (Joe)")
  (need N1 "reads and writes happen in code; only what's needed reaches the context (Joe)" :serves G :group "access")
  (need N2 "holds large amounts of data across sessions (Joe)" :serves G :group "storage")
  (need N3 "flexible: any kind of record, not one fixed schema (Joe)" :serves G :group "storage")
  (need N4 "findable: memory files stay the triggers and point at what's in the store" :serves G :group "access")
  (need N5 "survives the endpoint being undocumented: fails loudly, has a fallback" :serves G :group "access")
  (need N6 "the live-skills artifact is out of scope; only the py helper (Joe)" :serves G :group "scope")
  (solution S1 "lsdb in the plugin as its own skill; its get/list/query/set/update/delete cover this directly, so no separate memstore layer" :meets (N1 N3) :status built :group "access")
  (solution S2 "one store artifact per account (a minimal page declaring db, owner-only writes), its URL recorded in memory; cross-account sharing isn't possible (invited editors can't use artifact data from code)" :meets (N2 N6) :status built :group "storage")
  (solution S3 "records as JSON docs with light metadata (kind, created, source session, tags) plus free-form body; payloads over the doc size limit go through lsdb blobs (parts + sha256 manifest)" :meets (N2 N3) :status built :group "storage")
  (solution S4 "a memory file 'importance: the bulk store ...' with the URL, collection list and how to query; ?! pointer in preferences" :meets N4 :status built :group "access")
  (solution S5 "exit codes from lsdb surfaced; outside claude.ai/code sessions fall back to the ArtifactData tool with out_dir" :meets N5 :status built :group "access")
  (test T1 "write and read back a doc and a chunked large payload through lsdb (blobs for the large one); only the summary line prints" :tests (S1 S3))
  (test T2 "a fresh session finds the store from memory and queries it without opening the page" :tests (S2 S4))
  (test T3 "with the session env removed, lsdb exits 3 with the fallback message" :tests S5))
