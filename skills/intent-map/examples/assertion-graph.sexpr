(intent-map "Assertion graph + dependency solver"
  (goal G "compile once, then feed forward via code as a replacement for attention (Joe)")
  (need N1 "relevance decided by code from explicit links, not attention" :serves G :group "read time")
  (need N2 "each message's meaning captured once, without loss" :serves G :group "write time")
  (need N3 "relations explicit when written, not inferred later (Joe: explicit sexpr)" :serves G :group "write time")
  (need N4 "every claim carries provenance; trust = source integrity (Joe: Descartes)" :serves G :group "store")
  (need N5 "credence follows from dependencies; retractions propagate (Joe: this depends on that)" :serves G :group "solver")
  (need N6 "cheap enough to run on every message" :serves G :group "plumbing")
  (need N7 "the raw log is never lost" :serves G :group "plumbing")
  (need N8 "failures are loud and auditable" :serves G :group "plumbing")
  (need N9 "links get found even when the related statement is far back or worded differently" :serves G :group "write time")
  (solution S1 "read-time traversal + window assembly with reasons and an obligations line" :meets N1 :status not-built :group "read time")
  (solution S2a "extractor: statements per message" :meets N2 :status untested :group "write time")
  (solution S2b "message agents judging their own message (best recall on the compaction test)" :meets N2 :status measured :group "write time")
  (solution S3 "winnow-style sexpr relations + parser as contract (fold.py); relation types still to define" :meets N3 :status partial :group "write time")
  (solution S4 "(assert :by :at ...) wrapper on every item" :meets N4 :status design :group "store")
  (solution S5 "ProbLog / ATMS-style solver; correlated sources share a parent; open: cycles, scale, learned trust" :meets N5 :status design :group "solver")
  (solution S6 "DeepSeek Flash $0.0002/pair, Jev $0.0024/191 pairs, cached shared prefixes" :meets N6 :status measured :group "plumbing")
  (solution S7 "littlewing raw records pushed to flight-recorder" :meets N7 :status built :group "plumbing")
  (solution S8 "append-only log, parser rejects, dsx tripwires and logging" :meets N8 :status partial :group "plumbing")
  (solution S9 "extractor view = recent + code-picked candidates; misses caught by a sweep or by asking old message agents (main open risk)" :meets N9 :status design :group "write time")
  (test T1 "does s2's winnow graph hold the 166 items the compaction summary dropped?" :tests (S2a S3))
  (test T2 "8192 truncation replay: would a code-built window have pulled the note in?" :tests (S1 S3 S9)))
