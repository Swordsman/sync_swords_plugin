(intent-map "Iteration backlog 2026-11-05"
  (project "plugin")
  (ref lsdb-skill "the backlog extends lsdb to littlewing and blobs")
  (ref db-memory "the bulk memory store the backlog builds on")
  (ref memory-skill "memory-structuring updates (markers, consent test)")
  (ref composable-graph-views "the Intent Maps viewer reuses its rules engine")
  (goal G "work through everything left from this session, unattended, until nothing is left (Joe)")
  (need N1 "intent maps live in one giant artifact: created and edited without burning tokens, correlating projects, builds, ideas and concepts (Joe)" :serves G :group "lsdb consumers")
  (need N2 "littlewing uses lsdb (Joe)" :serves G :group "lsdb consumers")
  (need N3 "memory-structuring uses lsdb and knows today's markers (!lock, edit policy, '.' sub-files) (Joe)" :serves G :group "memory")
  (need N4 "large amounts of data between sessions (Joe)" :serves G :group "lsdb consumers")
  (need N5 "the plugin goes public: no secrets or personal data in it (Joe)" :serves G :group "plugin")
  (need N6 "code files under 200 lines; projects over 500 lines hyper-modular (Joe)" :serves G :group "plugin")
  (need N7 "memory-structuring acts only with explicit, informed permission (Joe)" :serves G :group "memory")
  (need N8 "persist or lose: everything findable next session (Joe)" :serves G :group "memory")
  (solution S1 "Intent Maps artifact: write-once viewer (map list, engine render by #slug, overview graph of maps with explicit refs plus page-computed suggested links); maps stored as docs by intentmap.py --store" :meets N1 :status built :group "lsdb consumers")
  (solution S2 "intentmap.py split into modules under 200 lines (parse, render, store, cli)" :meets N6 :status built :group "plugin")
  (solution S3 "lsdb blobs: put_blob/get_blob split text over docs under the size limit, sha256 manifest checked on read" :meets (N4 N2) :status built :group "lsdb consumers")
  (solution S4 "littlewing lsdb sink: per-account store URL in config; session index doc + .wno record as a blob; raw JSONL stays on existing backends" :meets N2 :status built :group "lsdb consumers")
  (solution S5 "memory-structuring references: !lock, edit policy, '.' router sub-files, optional lsdb bulk tier (with consent)" :meets (N3 N7) :status built :group "memory")
  (solution S6 "scan the plugin for keys, tokens, emails, account ids; remove what's found" :meets N5 :status built :group "plugin")
  (solution S7 "consent test: subagent with the skill gets 'organize my memory'; pass = explains and asks before any memory call" :meets N7 :status built :group "memory")
  (solution S8 "session-index entry and a ?! pointer to the bulk store" :meets N8 :status built :group "memory")
  (solution S9 "littlewing.py (1151 lines) hyper-modular refactor: runs in every session's hooks, so only with tests first; left for Joe's call" :meets N6 :status not-built :group "plugin")
  (solution S10 "drop container hooks in ~/.claude/settings.json that duplicate the plugin's" :meets N8 :status built :group "plugin")
  (test T1 "a map pushed with --store shows in the viewer list and renders; a map with a ref links to it in the overview" :tests (S1 S2))
  (test T2 "a 1 MB blob round-trips with its hash checked" :tests S3)
  (test T3 "a littlewing record lands in the store under the size limits" :tests S4)
  (test T4 "rescan finds nothing" :tests S6)
  (test T5 "the consent subagent asks before any memory call" :tests (S5 S7))
  (test T6 "a fresh session can find the store from memory alone" :tests S8)
  (need N9 "the store page can be a channel to Claude, like a dashboard (Joe)" :serves G :group "lsdb consumers")
  (solution S11 "inbox hook: SessionStart and (throttled) UserPromptSubmit read new inbox notes with lsdb and hand them to Claude as context; one per-account env var CLAUDE_DATA_STORE, shared with littlewing's sink" :meets (N9 N2) :status built :group "lsdb consumers")
  (test T7 "a note left on the page shows up in the next session's context, once, and not after it's marked done" :tests S11))
