(intent-map "Memory structuring skill"
  (goal G "a plugin skill that teaches any agent this memory-structuring system, offered to each user as an opt-in, since the plugin is shared and will go public (Joe)")
  (need N1 "ask the user whether they want this structuring before applying any of it (Joe)" :serves G :group "consent")
  (need N2 "generic: nothing specific to Joe (no his files, paths, projects or preferences)" :serves G :group "consent")
  (need N3 "teach the model: memory as code, always-on vs dormant presence, descriptions as triggers, !! / ?! / -$-, compartmentalizing, routing files, project files with keywords, session index, persist-or-lose" :serves G :group "content")
  (need N4 "teach the procedures: the sweep, the new-file checklist, the standing self-check" :serves G :group "content")
  (need N5 "fit the memory tool's real constraints: preferences injected in full, other files listed by description cut near 160 chars, a size cap on preferences" :serves G :group "content")
  (need N6 "adaptable: the user can decline, take only parts, or rename the prefixes" :serves G :group "consent")
  (need N7 "where it came from and the reasoning behind how it works (Joe)" :serves G :group "content")
  (need N8 "which harnesses/environments and features it needs to be viable, what makes it not viable, what makes it unnecessary (Joe)" :serves G :group "content")
  (need N9 "apply only with the user's explicit permission, after they've been fully informed of all the details (Joe)" :serves G :group "consent")
  (need N10 "no surprises: never stomp an existing, possibly elaborate setup without permission or warning (Joe)" :serves G :group "consent")
  (solution S1 "SKILL.md opens with a consent step: describe the system in a few lines, ask yes / no / which parts, record the answer in memory so it isn't asked again" :meets (N1 N6) :status design :group "consent")
  (solution S2 "modular references: model.md, syntax.md, procedures.md, each small" :meets (N3 N4 N5) :status design :group "content")
  (solution S3 "examples written generically (a tool the user uses, a project, a coding style), none from Joe's memory" :meets N2 :status design :group "content")
  (solution S4 "references/why.md: origin, the diagnosis (descriptions said what, not when; files got buried), the memory-as-code model and why each piece exists" :meets N7 :status design :group "content")
  (solution S5 "references/viability.md: required harness features, not-viable conditions, not-necessary conditions, costs, and 'observe your harness, don't assume'" :meets (N8 N5) :status design :group "content")
  (solution S6 "consent procedure: read-only survey first, explain with specifics for THIS store, viability check, explicit yes/no/parts, back up, show proposed changes before writing, apply in small steps, record the answer" :meets (N9 N10 N1) :status design :group "consent")
  (test T1 "a fresh agent with the skill asks, after explaining, before restructuring anything; after a no it leaves memory alone in later sessions" :tests (S1 S6))
  (test T2 "given a sample memory set, an agent following the skill rewrites descriptions to triggers and moves always-on lines out correctly" :tests (S2 S3))
  (test T3 "grep finds nothing from Joe's personal memory in the skill; only the origin credit names him" :tests (S3 S4)))
