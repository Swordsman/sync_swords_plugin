(intent-map "Composable graph views"
  (goal G "a composable, intuitive system that shows any kind of content as a graph, which the end user restructures however they want with easy, intuitive controls (Joe)")
  (need N1 "rules are data that can be changed while the page runs" :serves G :group "rules")
  (need N2 "rules are composed visually, not typed as sexpr text (Joe)" :serves G :group "controls")
  (need N3 "every view is a ruleset on one engine (Joe)" :serves G :group "engine")
  (need N4 "different element types/statuses/groups/single nodes get different behaviors, composably (Joe)" :serves G :group "rules")
  (need N5 "the user sets priorities inside the graph and rules can use them (Joe)" :serves G :group "tracker")
  (need N6 "a live tracker: edits on the page persist and Claude can read and write the same records" :serves G :group "tracker")
  (need N7 "sexpr stays the saved form, since rules and graph are trees (Joe)" :serves G :group "engine")
  (need N8 "it stays readable: crossing reduction, fit, zoom, highlight keep working" :serves G :group "engine")
  (need N9 "any kind of content: intent maps, dsx trees, winnow graphs, session logs etc (Joe)" :serves G :group "sources")
  (need N10 "edges get rules too: length, balance, direction, pulled toward a constraint (Joe)" :serves G :group "rules")
  (need N11 "parameters can follow a field, e.g. higher priority gets shorter edges (Joe)" :serves G :group "rules")
  (need N12 "balance in both senses: equal edge lengths, and edges spread evenly around a node (Joe)" :serves G :group "rules")
  (need N13 "easy for an end user: restructure without knowing the rule vocabulary (Joe)" :serves G :group "controls")
  (need N14 "stays fast with hundreds of nodes (a dsx tree)" :serves G :group "engine")
  (need N15 "one implicit root type: everything derives from it without declaring it; nodes and edges share it, so an edge is a node drawn as a line (Joe)" :serves G :group "model")
  (need N16 "linking two elements fills the gap by a connection policy: virtual, lazy, real edge, or a node in between, recursively with a depth limit (Joe)" :serves G :group "model")
  (need N17 "parallel universes: more than one root; elements from different universes engage only through a declared bridge (Joe)" :serves G :group "model")
  (need N18 "nested universes: one is an element in its parent, a black box whose ports are its contract (Joe)" :serves G :group "model")
  (need N19 "design by contract, black-box design and intent-driven design at every level (Joe)" :serves G :group "model")
  (need N20 "switching views morphs one into the other, so it reads as the same graph (Joe)" :serves G :group "engine")
  (need N21 "the viewport can never wander away from the graph; the policy lives at the camera, just before pixels, so no lower layer changes (Joe)" :serves G :group "space")
  (need N22 "layers: the data graph has no coordinates; the inner space simply is (points and their equivalence, no direction, no origin); the layout is the observer that measures; the camera maps to pixels (Joe)" :serves G :group "space")
  (need N23 "the inner space can have many dimensions, each optionally a ring, projected down to the screen (Joe)" :serves G :group "space")
  (need N24 "closed sets like kind and status are dimensions too, mapped both ways: type to position, and position back to type (Joe)" :serves G :group "space")
  (solution S1 "rule = selector + behaviors + params; each tick runs forces, integrates, then constraints in rule order" :meets (N1 N3) :status measured :group "engine")
  (solution S2 "rules live in the graph as rule nodes: wire one to what it acts on; chips on it switch behaviors on and set their parameters" :meets (N2 N4) :status design :group "controls")
  (solution S3 "selectors (kind, status, group, id, priority) and behaviors (shape, size, style, order-by, column, relax, stack, align, pin, repel, spring, gravity, attract)" :meets N4 :status built :group "rules")
  (solution S4 "'cards' and 'nodes' presets written as rulesets" :meets N3 :status measured :group "engine")
  (solution S5 ":priority on every node (read from the sexpr), plus a priority chip editable on the page" :meets N5 :status partial :group "tracker")
  (solution S6 "the page's shared data store holds nodes, links and rules; Claude reads and writes them through ArtifactData" :meets N6 :status design :group "tracker")
  (solution S7 "sexpr import/export of nodes and rules (the reader exists; rules are new)" :meets N7 :status partial :group "engine")
  (solution S8 "today's layout code as behaviors: barycentre ordering, fit, pan/zoom, upstream/downstream highlight, wires + electrons" :meets N8 :status built :group "engine")
  (solution S9 "source adapters: each turns a source into nodes, links and fields; intent-map sexpr exists, dsx tree store next" :meets N9 :status partial :group "sources")
  (solution S10 "a card template rule picks which fields a card or label shows, so any source draws sensibly" :meets (N9 N13) :status design :group "sources")
  (solution S11 "edge selectors (link kind, fields at either end) and edge behaviors: spring length, balance-length, direction, bundle" :meets (N10 N12) :status design :group "rules")
  (solution S12 "field-bound params: (scale FIELD lo hi -> a b) wherever a number goes" :meets N11 :status design :group "rules")
  (solution S13 "spread: edges around a node fan out at even angles" :meets N12 :status design :group "rules")
  (solution S14 "direct manipulation that writes rules: drop a node on a group to regroup it; a select-then-act menu in plain words ('line these up', 'keep together', 'shorter edges for higher priority')" :meets (N13 N2) :status design :group "controls")
  (solution S15 "Barnes-Hut repel above a node-count threshold" :meets N14 :status design :group "engine")
  (solution S16 "undo/redo over rule edits, so trying things is safe" :meets N13 :status design :group "controls")
  (solution S17 "element model on incidence form: one implicit root, types with :isa, rules attach at any level and the most specific wins (CSS/MRO style), traits mixed in; shape line|dot|card is a rule, so inverting nodes and edges is a view change" :meets (N15 N4) :status design :group "model")
  (solution S18 "connection policies looked up from both ends' types (Julia-style dispatch): virtual, lazy (made real on first touch), real, or an intermediate node; depth limit; a per-type rule for what happens when an endpoint is deleted" :meets N16 :status design :group "model")
  (solution S19 "universes: (universe NAME) declares a root; selectors, inheritance and policies stay inside it; cross-universe links need a (bridge ...) type for that pair of roots, else they are refused loudly; a bridge can require who claims it. Uses: rules and meta-nodes apart from data, sources kept apart, forks for what-if" :meets N17 :status design :group "model")
  (solution S20 "a nested universe is an element in its parent: collapsed it is one node, opened it is a graph (lazy); visibility opaque, translucent or transparent; ports are its only way in and out; inner universes inherit the parent's rules unless they override them" :meets (N18 N19) :status design :group "model")
  (solution S21 "every element can carry an intent (why it exists) and a contract (what it promises); ports check contracts at crossing; an intent map is this system showing its intent layer" :meets N19 :status design :group "model")
  (solution S22 "view switch tweens each node from where it is to where the new rules put it; cards shrink into dots and back" :meets N20 :status design :group "engine")
  (solution S23 "camera contract: at least a margin of graph stays on screen; after release, halve the distance to that target each frame and snap under half a pixel; resist (don't fight) while dragging; zoom bounded relative to graph size" :meets N21 :status design :group "space")
  (solution S24 "space layer stores phases per ring dimension with point equivalence only; the layout layer owns the ruler (metric), the only place a grain can appear; each universe picks its space: torus, flat plane, sphere or hyperbolic" :meets (N22 N17) :status design :group "space")
  (solution S25 "edges carry a lap offset tracked continuously (topological), so winding never changes under continuous motion; contract checked by summing laps around each cycle; geometric and hysteresis policies as per-universe options; display cut at the widest gap" :meets (N22 N16) :status design :group "space")
  (solution S26 "high-dimensional inner space (meaning dims plus free physics dims); a view is a projection onto two directions, so switching views rotates the projection (grand tour) and morphs for free; PCA per group of dims keeps each group readable; extra dims untangle and are squeezed out (Harel-Koren 2002)" :meets (N23 N20 N3) :status design :group "space")
  (solution S27 "category dims by shape: ring when adjacency means something (kind: goal need solution test is flow order), line when ordered (status), simplex when unordered; up = phase gives position, down = nearest arc gives type; the map must stay one-to-one" :meets N24 :status design :group "space")
  (solution S28 "selectors as regions in the space: arcs, half-spaces; overlap = and, union = or; region edges are draggable; distance to the edge can weight a rule so behaviors blend; transforms on type dims must keep every type's region separate, checked loudly" :meets (N4 N13 N24) :status design :group "space")
  (solution S29 "drop a card into another column: the down map names the type it landed in; per-universe rule decides whether that retypes it or proposes a retype to confirm" :meets (N13 N24) :status design :group "controls")
  (test T1 "the two presets reproduce the old card and node views (pixel diff, animation off)" :tests (S1 S4 S8))
  (test T2 "'pull the needs together and align them horizontally' made from the page controls alone, no text" :tests (S2 S3 S14))
  (test T3 "tracker round trip: Claude adds a need through ArtifactData, it appears; Joe changes a status on the page; Claude reads it back" :tests (S5 S6))
  (test T4 "sexpr round trip: export then import gives the same graph and rules" :tests S7)
  (test T5 "a dsx tree from ~/.dsx/dsx.db renders through the same page with no intent-map code paths, cards showing role, tokens and cost, smooth at its real size" :tests (S9 S10 S15))
  (test T6 "set from the page, 'balance these edges' cuts edge-length variance, 'spread' evens the angles, and 'higher priority, shorter' makes length fall with priority (measured)" :tests (S11 S12 S13))
  (test T7 "Joe restructures a map with only the page controls and finds it intuitive" :tests (S14 S16))
  (test T8 "invert: one rule turns every edge into a dot and back, with no data change, and only elements of degree 2 are drawn as lines" :tests (S17))
  (test T9 "link with no edge type given follows the ends' policy; a cross-universe link without a bridge is refused with a message; a lazy link becomes real when given an attribute" :tests (S18 S19))
  (test T10 "a nested universe collapses to one node and opens into its graph; only its ports connect outward; a port contract violation is reported" :tests (S20 S21))
  (test T11 "switching views animates every node from old to new place" :tests S22)
  (test T12 "pan or fling the view far away: the graph comes back on release, and never fights an active drag" :tests S23)
  (test T13 "continuous rotate/scale/shear never changes a cycle's total lap; the laps-sum check flags a hand-made violation" :tests (S24 S25))
  (test T14 "cards and nodes as two projections of one layout: switching rotates between them smoothly, and the cards projection still matches the current card view's order" :tests S26)
  (test T15 "type to position to type round-trips for every kind and status; a region selector picks exactly the nodes inside it; a transform that merges two types is refused" :tests (S27 S28)))
