GUARD_SOCK = os.path.join(GUARD_DIR, "guard.sock")


class ToolGuard:
    """Tool execution guard with per-server and per-tool policies.

    Config (from mcp config JSON):
      "guard": {
        "default": "ask",
        "servers": {
          "safe_server": "allow",
          "dangerous_server": "deny",
          "serena": {
            "default": "ask",
            "tools": {
              "read_file": "allow",
              "execute_shell_command": "ask"
            }
          }
        }
      }

    Server value can be a string (applies to all tools) or an object
    with per-tool overrides and a default.

    "allow" = execute without asking
    "deny"  = block, return denial message to model
    "ask"   = prompt on stdin (tty) or via FIFO pair at $DS_GUARD_DIR
    """

    def __init__(self, config: dict):
        guard_config = config.get("guard", {})
        self.default = guard_config.get("default", "allow")
        self.servers: dict = guard_config.get("servers", {})

    def _resolve_policy(self, server_name: str, tool_name: str):
        """Return policy string or dict with allow_args constraints."""
        server_policy = self.servers.get(server_name, self.default)
        if isinstance(server_policy, str):
            return server_policy
        if isinstance(server_policy, dict):
            tools = server_policy.get("tools", {})
            bare = tool_name.split("__")[-1] if "__" in tool_name else tool_name
            if bare in tools:
                return tools[bare]
            if tool_name in tools:
                return tools[tool_name]
            return server_policy.get("default", self.default)
        return self.default

    @staticmethod
    def _check_args(policy: dict, arguments: dict) -> str | None:
        """Check argument constraints. Returns denial string or None to allow.

        Policy dict: {"policy": "allow", "allow_args": {"path": ["file1", "file2"]}}
        Values in allow_args lists are matched against the basename of the argument.
        """
        allow_args = policy.get("allow_args", {})
        for arg_name, allowed in allow_args.items():
            val = arguments.get(arg_name, "")
            basename = os.path.basename(str(val))
            if basename not in allowed:
                return f"[DENIED] {arg_name}={val!r} not in allowed list"
        return None

    def check(self, server_name: str, tool_name: str, arguments: dict) -> str | None:
        """Return None to allow, or a non-empty string to block (becomes tool result)."""
        policy = self._resolve_policy(server_name, tool_name)

        if isinstance(policy, dict):
            base_policy = policy.get("policy", "allow")
            if base_policy == "deny":
                return f"[DENIED] Tool {tool_name} blocked by guard policy"
            args_check = self._check_args(policy, arguments)
            if args_check:
                return args_check
            if base_policy == "ask":
                return self._ask_user(server_name, tool_name, arguments)
            return None

        if policy == "allow":
            return None
        if policy == "deny":
            return f"[DENIED] Tool {tool_name} blocked by guard policy"
        if policy == "ask":
            return self._ask_user(server_name, tool_name, arguments)
        return None

    def _ask_user(self, server_name: str, tool_name: str, arguments: dict) -> str | None:
        if sys.stdin.isatty():
            return self._ask_tty(server_name, tool_name, arguments)
        if os.path.exists(GUARD_SOCK):
            return self._ask_socket(server_name, tool_name, arguments)
        if os.path.exists(GUARD_REQ) and os.path.exists(GUARD_RESP):
            return self._ask_pipe(server_name, tool_name, arguments)
        return f"[DENIED] Tool {tool_name} requires approval but no guard socket or pipes at {GUARD_DIR}"

    def _ask_tty(self, server_name: str, tool_name: str, arguments: dict) -> str | None:
        arg_summary = json.dumps(arguments, indent=2) if arguments else "(none)"
        print(f"\n[guard] {server_name}::{tool_name}", file=sys.stderr)
        print(f"  args: {arg_summary}", file=sys.stderr)
        try:
            answer = input("  allow? [y/N] ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            return f"[DENIED] Tool {tool_name} — user cancelled"
        if answer in ("y", "yes"):
            return None
        return f"[DENIED] Tool {tool_name} — user declined"

    def _ask_pipe(self, server_name: str, tool_name: str, arguments: dict) -> str | None:
        """Send tool call to approval pipe, block for response.

        Response protocol:
          "y" / "yes" / "allow"  → execute the tool call as-is
          "n" / "no" / "deny"   → block, return denial to model
          anything else          → block, return the response text as the tool result
                                   (lets the approver redirect: "do this instead")
        """
        import signal
        request = json.dumps({
            "server": server_name,
            "tool": tool_name,
            "args": arguments,
        })
        def _timeout_handler(signum, frame):
            raise TimeoutError("guard pipe timeout — no reader on FIFO")
        try:
            old_handler = signal.signal(signal.SIGALRM, _timeout_handler)
            signal.alarm(10)
            with open(GUARD_REQ, "w") as f:
                f.write(request + "\n")
                f.flush()
            signal.alarm(10)
            with open(GUARD_RESP, "r") as f:
                answer = f.readline().strip()
            signal.alarm(0)
            signal.signal(signal.SIGALRM, old_handler)
            lower = answer.lower()
            if lower in ("y", "yes", "allow"):
                return None
            if lower in ("n", "no", "deny"):
                return f"[DENIED] Tool {tool_name} — approver declined"
            return f"[REDIRECT] {answer}"
        except TimeoutError:
            signal.alarm(0)
            print(f"[guard] FIFO timeout — no guard process reading {GUARD_REQ}", file=sys.stderr)
            return f"[DENIED] Tool {tool_name} — guard pipe timeout (no reader after 10s)"
        except (OSError, IOError) as e:
            signal.alarm(0)
            return f"[DENIED] Tool {tool_name} — guard pipe error: {e}"

    def _ask_socket(self, server_name: str, tool_name: str, arguments: dict) -> str | None:
        """Send tool call to guard socket, block for response."""
        import socket as _socket
        request = json.dumps({
            "server": server_name,
            "tool": tool_name,
            "args": arguments,
        })
        try:
            sock = _socket.socket(_socket.AF_UNIX, _socket.SOCK_STREAM)
            sock.settimeout(10)
            sock.connect(GUARD_SOCK)
            sock.settimeout(120)
            sock.sendall((request + "\n").encode())
            buf = b""
            while b"\n" not in buf:
                chunk = sock.recv(4096)
                if not chunk:
                    break
                buf += chunk
            sock.close()
            answer = buf.decode().strip()
            if not answer:
                return f"[DENIED] Tool {tool_name} — guard returned empty response"
            lower = answer.lower()
            if lower in ("y", "yes", "allow"):
                return None
            if lower in ("n", "no", "deny"):
                return f"[DENIED] Tool {tool_name} — approver declined"
            return f"[REDIRECT] {answer}"
        except Exception as e:
            return f"[DENIED] Tool {tool_name} — guard socket error: {e}"

    @staticmethod
    def setup_pipes():
        """Create the FIFO pair for external approval. Call once before starting ds."""
        os.makedirs(GUARD_DIR, exist_ok=True)
        for path in (GUARD_REQ, GUARD_RESP):
            if os.path.exists(path):
                os.remove(path)
            os.mkfifo(path)
        return GUARD_DIR


class McpConnection:
    """A live connection to one MCP server."""

    def __init__(self, name: str, session, read_stream, write_stream, cm_stack):
        self.name = name
        self.session = session
        self._read_stream = read_stream
        self._write_stream = write_stream
        self._cm_stack = cm_stack
        self.tools: dict[str, dict] = {}  # tool_name → openai tool schema

    async def close(self):
        try:
            await self._cm_stack.aclose()
        except (RuntimeError, BaseExceptionGroup):
            pass

    async def discover_tools(self):
        result = await self.session.list_tools()
        for tool in result.tools:
            namespaced = f"{self.name}__{tool.name}"
            self.tools[namespaced] = {
                "type": "function",
                "function": {
                    "name": namespaced,
                    "description": tool.description or "",
                    "parameters": tool.inputSchema or {"type": "object", "properties": {}},
                },
            }

    async def call_tool(self, tool_name: str, arguments: dict) -> str:
        original_name = tool_name.split("__", 1)[1] if "__" in tool_name else tool_name
        try:
            result = await self.session.call_tool(original_name, arguments)
        except Exception as e:
            return f"[ERROR] MCP call failed for {tool_name}: {e}"
        parts = []
        for content in result.content:
            if hasattr(content, "text"):
                parts.append(content.text)
            else:
                parts.append(str(content))
        output = "\n".join(parts)
        if result.isError:
            output = f"[ERROR] {output}"
        return output


async def connect_mcp_server(name: str, command: str, args: list[str]) -> McpConnection:
    from mcp.client.stdio import StdioServerParameters, stdio_client
    from mcp.client.session import ClientSession

    server_params = StdioServerParameters(command=command, args=args)
    # We need to manage the async context managers manually
    # since we want the connection to persist beyond this function
    import contextlib
    cm_stack = contextlib.AsyncExitStack()
    devnull = open(os.devnull, "w")
    read_stream, write_stream = await cm_stack.enter_async_context(
        stdio_client(server_params, errlog=devnull)
    )
    session = await cm_stack.enter_async_context(
        ClientSession(read_stream, write_stream)
    )
    await session.initialize()
    conn = McpConnection(name, session, read_stream, write_stream, cm_stack)
    await conn.discover_tools()
    return conn


def load_mcp_config(config_path: str | None = None) -> dict:
    """Load MCP server config from --mcp-config, $DS_MCP_CONFIG, or default path.

    Config source can be a file path, a pipe, or inline JSON via env var.
    Returns {"servers": {...}} or empty dict if no config found.
    """
    source = config_path or os.environ.get("DS_MCP_CONFIG")
    if source is not None:
        if source.strip().startswith("{"):
            return json.loads(source)
        with open(source) as f:
            return json.load(f)
    if os.path.exists(DEFAULT_MCP_CONFIG_PATH):
        with open(DEFAULT_MCP_CONFIG_PATH) as f:
            return json.load(f)
    return {}


def parse_mcp_arg(mcp_arg: str, mcp_config: dict) -> tuple[str, str, list[str]]:
    """Parse an --mcp argument into (name, command, args).

    Accepts either a server name (looked up in config) or a full command string.
    """
    servers = mcp_config.get("servers", {})
    if " " not in mcp_arg and mcp_arg in servers:
        srv = servers[mcp_arg]
        return mcp_arg, srv["command"], srv.get("args", [])

    import shlex
    parts = shlex.split(mcp_arg)
    name = os.path.basename(parts[0])
    return name, parts[0], parts[1:]


def gate_output(output: str, tool_name: str) -> str:
    """Spill large outputs to disk."""
    if len(output) <= GATE_THRESHOLD:
        return output
    os.makedirs(GATE_DIR, exist_ok=True)
    ts = time.strftime("%Y%m%d_%H%M%S")
    path = os.path.join(GATE_DIR, f"{ts}_{os.getpid()}_{tool_name}.txt")
    with open(path, "w") as f:
        f.write(output)
    return (
        f"[GATE] Output too large ({len(output):,} chars) — saved to {path}\n"
        f"Read, grep, or head that file as needed."
    )


