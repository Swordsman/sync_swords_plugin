# Main
# ---------------------------------------------------------------------------

async def async_main(args, content_out, think_out, raw_out, usage_out, _opened) -> None:
    model_map = {"pro": "deepseek-v4-pro", "flash": "deepseek-v4-flash"}
    model = model_map[args.model]
    extra_kwargs = build_extra_kwargs(args.think)

    base_url = "https://api.deepseek.com/beta" if args.beta else "https://api.deepseek.com/v1"
    import httpx
    client = OpenAI(
        api_key=load_api_key(),
        base_url=base_url,
        http_client=httpx.Client(timeout=httpx.Timeout(connect=10, read=300, write=30, pool=10)),
    )

    # Connect to MCP servers
    mcp_connections: list[McpConnection] = []
    tools: dict[str, McpConnection] = {}  # namespaced_tool_name → connection
    tool_schemas: list[dict] = []

    mcp_config = load_mcp_config(args.mcp_config)
    guard = ToolGuard(mcp_config)

    for mcp_arg in args.mcp:
        name, command, cmd_args = parse_mcp_arg(mcp_arg, mcp_config)
        try:
            conn = await connect_mcp_server(name, command, cmd_args)
            mcp_connections.append(conn)
            for tool_name, schema in conn.tools.items():
                tools[tool_name] = conn
                tool_schemas.append(schema)
            print(f"[mcp] {name}: {len(conn.tools)} tools", file=sys.stderr)
        except Exception as e:
            print(f"[mcp] {name}: failed to connect — {e}", file=sys.stderr)
            sys.exit(1)

    # Build messages
    if args.session:
        messages = load_session(args.session)
        if not messages and args._system_prompt:
            messages = [{"role": "system", "content": args._system_prompt}]
    elif args._system_prompt:
        messages = [{"role": "system", "content": args._system_prompt}]
    else:
        messages = []

    # Build user message
    if args.task or args.context or getattr(args, "_stdin_content", None):
        context_parts: list[str] = []
        stdin_content = getattr(args, "_stdin_content", None)
        if stdin_content:
            context_parts.append(f"<current_content>\n{stdin_content}\n</current_content>")
        for ctx_file in args.context:
            try:
                with open(ctx_file) as f:
                    context_parts.append(f"<file path=\"{ctx_file}\">\n{f.read()}\n</file>")
            except FileNotFoundError:
                print(f"Warning: context file not found: {ctx_file}", file=sys.stderr)
        user_content = args.task or ""
        if args.re2 and not args.re2_context:
            if user_content:
                user_content = apply_re2(user_content, args.re2)
            if context_parts:
                user_content = user_content + "\n\n" + "\n\n".join(context_parts) if user_content else "\n\n".join(context_parts)
        else:
            if context_parts:
                user_content = "\n\n".join(context_parts) + ("\n\n" + user_content if user_content else "")
            if args.re2 and user_content:
                user_content = apply_re2(user_content, args.re2)
        if user_content:
            user_msg = {"role": "user", "content": user_content}
            if args.name:
                user_msg["name"] = args.name
            messages.append(user_msg)
            if args.session:
                append_session(args.session, user_msg)

    # --guarantee-json-output: DS requires "json" in the prompt AND a format example.
    # Without both, DeepSeek may produce an infinite stream of whitespace.
    if args.guarantee_json_output:
        all_content = " ".join(
            m.get("content", "") for m in messages
            if isinstance(m.get("content"), str)
        )
        all_lower = all_content.lower()
        if "json" not in all_lower:
            print("Error: --guarantee-json-output requires the word 'json' somewhere in "
                  "the prompt (DeepSeek API requirement).", file=sys.stderr)
            sys.exit(1)
        if not has_json_object(all_content):
            print("Error: --guarantee-json-output requires a JSON format example in the "
                  "prompt (e.g. {\"key\": \"value\"}). Without one, DeepSeek may produce "
                  "an infinite stream of whitespace.", file=sys.stderr)
            sys.exit(1)

    # --prefix: mark last assistant message for prefix completion
    if args.prefix:
        for i in range(len(messages) - 1, -1, -1):
            if messages[i].get("role") == "assistant":
                messages[i]["prefix"] = True
                break
        else:
            print("Warning: --prefix set but no assistant message found to mark.", file=sys.stderr)

    # --dry-run: show what would be sent, exit
    if args.dry_run:
        dry = {
            "model": model,
            "base_url": base_url,
            "stream": not args.no_stream,
            "messages": messages,
            "extra_kwargs": extra_kwargs,
        }
        if args.temperature is not None:
            dry["temperature"] = args.temperature
        if args.top_p is not None:
            dry["top_p"] = args.top_p
        if args.max_tokens is not None:
            dry["max_tokens"] = args.max_tokens
        if args.logprobs:
            dry["logprobs"] = True
        if args.top_logprobs is not None:
            dry["top_logprobs"] = args.top_logprobs
        if args.stop:
            dry["stop"] = args.stop
        if args.user_id:
            dry["user_id"] = args.user_id
        if args.timeout is not None:
            dry["timeout"] = args.timeout
        if tool_schemas:
            dry["tools"] = tool_schemas
            dry["parallel_tool_calls"] = False
        if args.tool_choice:
            dry["tool_choice"] = _resolve_tool_choice(args.tool_choice, tool_schemas)
        if args.guarantee_json_output:
            dry["response_format"] = {"type": "json_object"}
        print(json.dumps(dry, indent=2), file=content_out)
        for conn in mcp_connections:
            await conn.close()
        for fh in _opened:
            fh.close()
        return

    # Agentic loop
    turn = 0
    totals = {"prompt_tokens": 0, "completion_tokens": 0, "reasoning_tokens": 0,
              "prompt_cache_hit_tokens": 0, "prompt_cache_miss_tokens": 0, "cost_usd": 0.0}
    while True:
        do_stream = not args.no_stream
        call_kwargs = dict(
            model=model,
            messages=messages,
            stream=do_stream,
            **extra_kwargs,
        )
        if do_stream:
            call_kwargs["stream_options"] = {"include_usage": True}
        if args.temperature is not None:
            call_kwargs["temperature"] = args.temperature
        if args.top_p is not None:
            call_kwargs["top_p"] = args.top_p
        if args.max_tokens is not None:
            call_kwargs["max_tokens"] = args.max_tokens
        if tool_schemas:
            call_kwargs["tools"] = tool_schemas
            call_kwargs["parallel_tool_calls"] = False
        if args.tool_choice:
            call_kwargs["tool_choice"] = _resolve_tool_choice(args.tool_choice, tool_schemas)
        if args.guarantee_json_output:
            call_kwargs["response_format"] = {"type": "json_object"}
        if args.logprobs:
            call_kwargs["logprobs"] = True
        if args.top_logprobs is not None:
            call_kwargs["top_logprobs"] = args.top_logprobs
        if args.stop:
            call_kwargs["stop"] = args.stop
        if args.user_id:
            call_kwargs.setdefault("extra_body", {})
            call_kwargs["extra_body"]["user_id"] = args.user_id
        if args.timeout is not None:
            call_kwargs["timeout"] = args.timeout

        interrupted = False
        max_retries = 3
        TURN_WALL_CLOCK = 660
        for attempt in range(max_retries + 1):
            try:
                def _turn_timeout_handler(signum, frame):
                    raise TimeoutError(f"turn wall clock exceeded ({TURN_WALL_CLOCK}s)")
                old_alarm = signal.signal(signal.SIGALRM, _turn_timeout_handler)
                signal.alarm(TURN_WALL_CLOCK)
                response = client.chat.completions.create(**call_kwargs)
                if do_stream:
                    resp_iter = response
                    thinking_on = args.think != "off"
                    idle_secs = args.timeout if args.timeout is not None else (120 if thinking_on else 30)
                    resp_iter = _idle_timeout_iter(response, idle_secs)
                    content, thinking, tool_calls, usage, finish_reason = stream_response(resp_iter, content_out, think_out, raw_out)
                else:
                    content, thinking, tool_calls, usage, finish_reason = handle_response_sync(response, content_out, think_out, raw_out)
                signal.alarm(0)
                signal.signal(signal.SIGALRM, old_alarm)

                if usage_out and usage:
                    cost = _estimate_cost(usage, model)
                    turn_record = {"turn": turn, **usage}
                    if usage.get("prompt_tokens", 0) > 0:
                        turn_record["cache_hit_pct"] = round(
                            usage.get("prompt_cache_hit_tokens", 0) / usage["prompt_tokens"] * 100, 1)
                    if cost is not None:
                        turn_record["cost_usd"] = round(cost, 6)
                        totals["cost_usd"] += cost
                    for k in ("prompt_tokens", "completion_tokens", "reasoning_tokens",
                              "prompt_cache_hit_tokens", "prompt_cache_miss_tokens"):
                        totals[k] += usage.get(k, 0)
                    print(json.dumps(turn_record), file=usage_out, flush=True)

                if finish_reason == "length":
                    print("[ds] warning: response truncated — finish_reason=length. "
                          "Increase --max-tokens or split your task.",
                          file=sys.stderr)
                elif finish_reason == "content_filter":
                    print("[ds] warning: response stopped by content filter.",
                          file=sys.stderr)
                elif finish_reason == "insufficient_system_resource":
                    print("[ds] warning: DeepSeek server ran out of resources. "
                          "Retry or use a smaller context.",
                          file=sys.stderr)

                break
            except KeyboardInterrupt:
                print("\n[ds] interrupted", file=sys.stderr)
                interrupted = True
                break
            except Exception as e:
                status = getattr(e, "status_code", None) or getattr(e, "status", None)
                request_id = None
                resp = getattr(e, "response", None)
                if resp is not None:
                    headers = getattr(resp, "headers", {})
                    request_id = headers.get("x-request-id") or headers.get("x-ds-request-id")
                if status in (429, 503) and attempt < max_retries:
                    wait = 2 ** attempt
                    print(f"[ds] {status} — retrying in {wait}s (attempt {attempt + 1}/{max_retries})",
                          file=sys.stderr)
                    time.sleep(wait)
                    continue
                parts = ["[ds] API error"]
                if status:
                    parts.append(f"HTTP {status}")
                if request_id:
                    parts.append(f"request_id={request_id}")
                parts.append(str(e))
                print("\n" + " ".join(parts), file=sys.stderr)
                sys.exit(1)
        if interrupted:
            break

        assistant_msg: dict = {"role": "assistant"}
        if content:
            assistant_msg["content"] = content
        elif tool_calls:
            assistant_msg["content"] = ""
        if thinking:
            assistant_msg["reasoning_content"] = thinking
        if tool_calls:
            assistant_msg["tool_calls"] = [
                {
                    "id": tc["id"],
                    "type": "function",
                    "function": {"name": tc["name"], "arguments": tc["arguments"]},
                }
                for tc in tool_calls
            ]
        messages.append(assistant_msg)
        if args.session:
            append_session(args.session, assistant_msg)

        if turn == 0 and args.session:
            first_user = next((m.get("content", "") for m in messages if m.get("role") == "user"), "")
            if isinstance(first_user, list):
                first_user = " ".join(str(c) for c in first_user)
            if first_user:
                _auto_title_session(args.session, first_user, model=args.model)

        if not tool_calls:
            break

        turn += 1
        if args.max_turns and turn >= args.max_turns:
            print(f"[ds] max turns ({args.max_turns}) reached, stopping", file=sys.stderr)
            break

        for tc in tool_calls:
            try:
                call_args = json.loads(tc["arguments"]) if tc["arguments"] else {}
            except (json.JSONDecodeError, TypeError) as e:
                result = f"Error: malformed tool call arguments (JSON parse failed: {e}). Re-send with valid JSON. Arrays must use [...], strings must be quoted."
                tool_msg = {"role": "tool", "tool_call_id": tc["id"], "content": result}
                messages.append(tool_msg)
                if args.session:
                    append_session(args.session, tool_msg)
                print(f"[ds] malformed tool args for {tc.get('name','?')}: {tc.get('arguments','')[:200]}", file=sys.stderr)
                continue
            conn = tools.get(tc["name"])
            if conn is None:
                result = f"Unknown tool: {tc['name']}"
            else:
                veto = guard.check(conn.name, tc["name"], call_args)
                if veto:
                    result = veto
                else:
                    result = await conn.call_tool(tc["name"], call_args)
                    result = gate_output(result, tc["name"])
            tool_msg = {"role": "tool", "tool_call_id": tc["id"], "content": result}
            messages.append(tool_msg)
            if args.session:
                append_session(args.session, tool_msg)

    if usage_out and any(v for k, v in totals.items() if k != "cost_usd"):
        if totals.get("prompt_tokens", 0) > 0:
            totals["cache_hit_pct"] = round(
                totals["prompt_cache_hit_tokens"] / totals["prompt_tokens"] * 100, 1)
        totals["cost_usd"] = round(totals["cost_usd"], 6)
        print(json.dumps({"total": True, **totals}), file=usage_out, flush=True)

    # Cleanup MCP connections
    for conn in mcp_connections:
        await conn.close()

    for fh in _opened:
        fh.close()


_DEFAULT_MAX_DEPTH = 8

def main() -> None:
    remaining = int(os.environ.get("DS_MAX_DEPTH", str(_DEFAULT_MAX_DEPTH)))
    if remaining <= 0:
        print(
            f"Error: ds recursion limit reached — aborting to prevent runaway.\n"
            f"\n"
            f"  ds calls itself for features like --help-me-out and --auto-title.\n"
            f"  Each nested call decrements the DS_MAX_DEPTH environment variable\n"
            f"  (default: {_DEFAULT_MAX_DEPTH}). When it hits 0, this error fires.\n"
            f"\n"
            f"  To raise the limit:  export DS_MAX_DEPTH=16\n"
            f"  For a single call:   DS_MAX_DEPTH=16 ds \"your task here\"",
            file=sys.stderr)
        sys.exit(1)
    os.environ["DS_MAX_DEPTH"] = str(remaining - 1)

    parser = argparse.ArgumentParser(
        description="DeepSeek agent / write worker"
    )
    parser.add_argument("task", nargs="?", default=None,
                        help="Task / user message (optional when continuing a session)")
    parser.add_argument(
        "--session", "-s", metavar="FILE.jsonl",
        help="JSONL session file — load history, append new messages each turn"
    )
    parser.add_argument(
        "--context", "-c", action="append", default=[], metavar="FILE",
        help="File to use as context (injected into user message); repeatable"
    )
    parser.add_argument(
        "--model", "-m", default="pro", choices=["pro", "flash"],
        help="Model: 'pro' (default) or 'flash'"
    )
    parser.add_argument(
        "--think", nargs="?", const="auto", default=None, metavar="LEVEL",
        help="Thinking: off | high | max  (bare --think = API default; omit = same)"
    )
    parser.add_argument(
        "--mcp", action="append", default=[], metavar="SERVER",
        help="Connect to an MCP server (name from config, or full command string); repeatable"
    )
    parser.add_argument(
        "--mcp-config", metavar="PATH",
        help="MCP server config (JSON file/pipe; also $DS_MCP_CONFIG env var or inline JSON)"
    )
    parser.add_argument(
        "--out", "-o", metavar="FILE",
        help="Write content output to FILE (default: stdout). Streams in real-time — each token is flushed to disk as it arrives. Use 'tail -f FILE' to watch live."
    )
    parser.add_argument(
        "--think-out", metavar="FILE",
        help="Write thinking output to FILE (default: stdout). Streams in real-time — each token is flushed to disk as it arrives."
    )
    parser.add_argument(
        "--temperature", "-t", type=float, default=None,
        help="Sampling temperature (omit to use API default)"
    )
    parser.add_argument(
        "--top-p", type=float, default=None,
        help="Nucleus sampling top-p, 0-1 (omit to use API default; ignored when thinking is on)"
    )
    parser.add_argument(
        "--max-tokens", type=int, default=None,
        help="Max output tokens (omit to use API default; max 384K)"
    )
    parser.add_argument(
        "--max-turns", type=int, default=None,
        help="Cap on tool-call loop iterations. The loop terminates naturally "
             "when the model responds without calling a tool; this sets a hard "
             "upper bound for visibility and control. Use this to give workers "
             "a clean stopping point for longer or more complex tasks. If your "
             "agent has good instructions and the right resources, unbounded is "
             "probably what you want. If you're not sure your setup is stable, "
             "start with a low value like 30-40. Sane values are typically "
             "30-300. Requires --mcp (without tools there's no loop to cap) "
             "(default: unlimited)"
    )
    parser.add_argument(
        "--raw", metavar="FILE",
        help="Write raw JSON response chunks as JSONL"
    )
    parser.add_argument(
        "--usage-out", metavar="FILE",
        help="Write per-turn usage/cost JSON to FILE (one JSON object per turn, totals at end)"
    )
    parser.add_argument(
        "--re2", default=None, choices=["paper", "xml"],
        help="Apply RE2 re-reading prompt technique (paper or xml). Implies --think off. "
             "Only doubles the task instruction, not piped/context content."
    )
    parser.add_argument(
        "--re2-context", action="store_true", default=False,
        help="Include context (stdin, --context files) in the RE2 re-read. "
             "Default: only the task instruction is doubled."
    )
    parser.add_argument(
        "--no-stream", action="store_true", default=False,
        help="Disable streaming — wait for full response before outputting."
    )
    parser.add_argument(
        "-q", "--quiet", action="store_true", default=False,
        help="Suppress thinking output (equivalent to --think-out /dev/null)."
    )
    parser.add_argument(
        "--persist", nargs="?", const="yes", default=None,
        help="Session persistence: 'yes'/'no' momentary; 'on'/'off' ongoing; "
             "or a name to target/create a named session. 'off' deactivates the "
             "current shell's session. Bare --persist = --persist yes."
    )
    parser.add_argument(
        "--title", default=None, metavar="TITLE",
        help="Human-friendly title for a persistent session (used with --persist)."
    )
    parser.add_argument(
        "--guarantee-json-output", action="store_true", default=False,
        help="Set response_format to json_object — guarantees valid JSON output."
    )
    parser.add_argument(
        "--system", default=None, metavar="TEXT",
        help="Override the default system prompt with this text."
    )
    parser.add_argument(
        "--system-file", default=None, metavar="FILE",
        help="Override the default system prompt with the contents of FILE."
    )
    parser.add_argument(
        "--timeout", type=float, default=None, metavar="SECS",
        help="Idle timeout in seconds — max time with no data from the API before aborting. "
             "Reset on each chunk received. Max 600 (10 min, DS hard ceiling)."
    )
    parser.add_argument(
        "--logprobs", action="store_true", default=False,
        help="Return log probabilities per token."
    )
    parser.add_argument(
        "--top-logprobs", type=int, default=None, metavar="N",
        help="Number of top log probabilities per token position (0-20). Implies --logprobs."
    )
    parser.add_argument(
        "--stop", action="append", default=[], metavar="SEQ",
        help="Stop sequence (repeatable, up to 16). Generation stops when any is produced."
    )
    parser.add_argument(
        "--name", default=None, metavar="NAME",
        help="Name field for the user message (allows the model to differentiate named entities)."
    )
    parser.add_argument(
        "--user-id", default=None, metavar="ID",
        help="User ID for per-user isolation and safety tracking."
    )
    parser.add_argument(
        "--beta", action="store_true", default=False,
        help="Use the beta API endpoint (enables prefix completion, strict tools, FIM)."
    )
    parser.add_argument(
        "--prefix", action="store_true", default=False,
        help="Prefix completion mode (beta): last assistant message is treated as a prefix "
             "the model completes from. Implies --beta."
    )
    parser.add_argument(
        "--dry-run", action="store_true", default=False,
        help="Show what would be sent to the API (messages, model, params) without calling it."
    )
    parser.add_argument(
        "--help-me-out", default=None, metavar="REQUEST",
        help="Describe what you want to do in plain English. ds will read its own --help "
             "and generate a ready-to-use command or wrapper script."
    )
    parser.add_argument(
        "--list-sessions", action="store_true", default=False,
        help="List persistent sessions with titles and dates, then exit."
    )
    parser.add_argument(
        "--balance", action="store_true", default=False,
        help="Check DeepSeek account balance, then exit."
    )
    parser.add_argument(
        "--list-models", action="store_true", default=False,
        help="List available DeepSeek models, then exit."
    )
    parser.add_argument(
        "--tool-choice", default=None, metavar="STRATEGY",
        help="Tool choice strategy: none, auto, required, or a specific function name."
    )
    parser.add_argument(
        "--usage-summary", action="store_true", default=False,
        help="Aggregate usage/cost across sessions from usage-out files, then exit."
    )
    parser.add_argument(
        "--show-turn", default=None, metavar="N",
        help="Print turn(s) from the session, then exit. Supports: N (single), "
             "N:M (range), -N (from end). 0-indexed. "
             "Requires --session or an active persistent session."
    )
    parser.add_argument(
        "--grep-session", default=None, metavar="PATTERN",
        help="Search session turns for PATTERN (regex), print matching turns, then exit."
    )
    parser.add_argument(
        "--grep-field", default=None,
        choices=["content", "reasoning_content", "role", "name"],
        help="Restrict --grep-session to a specific JSON field (default: content)."
    )
    parser.add_argument(
        "--session-info", action="store_true", default=False,
        help="Print session summary (turn count, roles, size), then exit."
    )
    parser.add_argument(
        "--alias", nargs="*", default=None, metavar="ARG",
        help="Alias management. 'ds --alias save NAME' saves current args as NAME. "
             "'ds --alias NAME [task]' loads alias. 'ds --alias list' shows all. "
             "'ds --alias delete NAME' removes one."
    )
    parser.add_argument(
        "--resume", default=None, metavar="QUERY",
        help="Resume a session by fuzzy-matching its title. If ambiguous, lists matches."
    )
    parser.add_argument(
        "--fork", nargs="?", const=-1, type=int, default=None, metavar="N",
        help="Fork current session into a new one. N = last turn to include (0-indexed). "
             "Bare --fork clones the entire session. Creates a new session dir and "
             "points 'current' at it."
    )
    parser.add_argument(
        "--inject", default=None, metavar="TEXT",
        help="Inject a message into the session without making an API call. "
             "Requires --session or an active persistent session."
    )
    parser.add_argument(
        "--inject-role", default="user", choices=["user", "assistant", "system"],
        help="Role for the injected message (default: user)."
    )
    args = parser.parse_args()

    # --alias: manage named argument presets
    if args.alias is not None:
        def _load_aliases():
            if os.path.isfile(ALIASES_PATH):
                try:
                    with open(ALIASES_PATH) as f:
                        return json.load(f)
                except (json.JSONDecodeError, OSError):
                    pass
            return {}

        def _save_aliases(aliases):
            os.makedirs(os.path.dirname(ALIASES_PATH), exist_ok=True)
            with open(ALIASES_PATH, "w") as f:
                json.dump(aliases, f, indent=2)

        if not args.alias or args.alias == ["list"]:
            aliases = _load_aliases()
            if not aliases:
                print("No aliases defined.")
            else:
                for name, cfg in sorted(aliases.items()):
                    flags = " ".join(f"--{k.replace('_', '-')} {v}" if v is not True
                                     else f"--{k.replace('_', '-')}"
                                     for k, v in cfg.items())
                    print(f"  {name}: {flags}")
            sys.exit(0)

        if args.alias[0] == "save":
            if len(args.alias) < 2:
                print("Error: --alias save requires a name.", file=sys.stderr)
                sys.exit(1)
            name = args.alias[1]
            aliases = _load_aliases()
            aliases[name] = _serialize_sticky_args(args)
            _save_aliases(aliases)
            print(f"[ds] alias '{name}' saved.", file=sys.stderr)
            sys.exit(0)

        if args.alias[0] == "delete":
            if len(args.alias) < 2:
                print("Error: --alias delete requires a name.", file=sys.stderr)
                sys.exit(1)
            name = args.alias[1]
            aliases = _load_aliases()
            if name not in aliases:
                print(f"Error: alias '{name}' not found.", file=sys.stderr)
                sys.exit(1)
            del aliases[name]
            _save_aliases(aliases)
            print(f"[ds] alias '{name}' deleted.", file=sys.stderr)
            sys.exit(0)

        # Load alias: ds --alias NAME [task]
        name = args.alias[0]
        aliases = _load_aliases()
        if name not in aliases:
            print(f"Error: alias '{name}' not found. Use --alias list to see available.",
                  file=sys.stderr)
            sys.exit(1)
        cfg = aliases[name]
        _SKIP_ALIAS = {"task", "session", "persist", "title", "alias"}
        for key, val in cfg.items():
            if key in _SKIP_ALIAS:
                continue
            current = getattr(args, key, None)
            if current is None or current is False or current == []:
                setattr(args, key, val)
        if len(args.alias) > 1:
            args.task = " ".join(args.alias[1:])

    # --list-sessions: print and exit
    if args.list_sessions:
        if os.path.isdir(SESSIONS_DIR):
            active_targets = set()
            if os.path.isdir(ACTIVE_DIR):
                for entry in os.listdir(ACTIVE_DIR):
                    link_path = os.path.join(ACTIVE_DIR, entry)
                    if os.path.islink(link_path):
                        active_targets.add(os.path.realpath(link_path))
            for d in sorted(os.listdir(SESSIONS_DIR)):
                if d in ("active", "current"):
                    continue
                meta_path = os.path.join(SESSIONS_DIR, d, "meta.json")
                title, created = "untitled", "?"
                if os.path.isfile(meta_path):
                    try:
                        with open(meta_path) as f:
                            meta = json.load(f)
                        title = meta.get("title") or "untitled"
                        created = meta.get("created", "?")
                    except (json.JSONDecodeError, OSError):
                        pass
                marker = " ←" if os.path.join(SESSIONS_DIR, d) in active_targets else ""
                print(f"  {d}  {created}  {title}{marker}")
        else:
            print("No sessions found.")
        sys.exit(0)

    # --balance: check account balance and exit
    if args.balance:
        import urllib.request
        api_key = load_api_key()
        req = urllib.request.Request(
            "https://api.deepseek.com/user/balance",
            headers={"Authorization": f"Bearer {api_key}", "Accept": "application/json"},
        )
        try:
            with urllib.request.urlopen(req, timeout=10) as resp:
                data = json.loads(resp.read())
            for info in data.get("balance_infos", []):
                print(f"  {info['currency']}  total: {info['total_balance']}  "
                      f"granted: {info['granted_balance']}  topped-up: {info['topped_up_balance']}")
            if not data.get("is_available"):
                print("  ⚠ balance insufficient for API calls", file=sys.stderr)
        except Exception as e:
            print(f"Error checking balance: {e}", file=sys.stderr)
            sys.exit(1)
        sys.exit(0)

    # --list-models: fetch available models and exit
    if args.list_models:
        import urllib.request
        api_key = load_api_key()
        req = urllib.request.Request(
            "https://api.deepseek.com/models",
            headers={"Authorization": f"Bearer {api_key}", "Accept": "application/json"},
        )
        try:
            with urllib.request.urlopen(req, timeout=15) as resp:
                data = json.loads(resp.read())
            for m in data.get("data", []):
                print(f"  {m.get('id', '?')}")
        except Exception as e:
            print(f"Error listing models: {e}", file=sys.stderr)
            sys.exit(1)
        sys.exit(0)

    # --help-me-out: use ds to explain ds
    if args.help_me_out:
        import subprocess, io
        help_buf = io.StringIO()
        help_parser = argparse.ArgumentParser(prog="ds", add_help=False)
        # Capture the full help text
        try:
            parser.parse_args(["--help"])
        except SystemExit:
            pass
        help_text = parser.format_help()
        ds_source_path = os.path.realpath(__file__)
        try:
            with open(ds_source_path) as f:
                ds_source = f.read()
        except OSError:
            ds_source = "(source not available)"
        prompt = (
            f"The user wants help with the `ds` CLI tool.\n\n"
            f"Here is the full --help output:\n\n```\n{help_text}\n```\n\n"
            f"Here is the full source code of the ds command:\n\n```python\n{ds_source}\n```\n\n"
            f"The user's request: {args.help_me_out}\n\n"
            f"Give them a ready-to-copy command, or if it's complex, a short wrapper script. "
            f"Be concise — they want to copy-paste and go, not read an essay. "
            f"Use the source code to understand nuances the help text doesn't cover."
        )
        result = subprocess.run(
            ["ds", "--persist", "no", "--think", "off", "-q", "--no-stream", "-m", "flash", prompt],
            capture_output=True, text=True,
        )
        print(result.stdout, end="")
        if result.stderr:
            print(result.stderr, end="", file=sys.stderr)
        sys.exit(result.returncode)

    # --usage-summary: aggregate usage across sessions
    if args.usage_summary:
        if not os.path.isdir(SESSIONS_DIR):
            print("No sessions found.")
            sys.exit(0)
        grand = {"prompt_tokens": 0, "completion_tokens": 0, "reasoning_tokens": 0,
                 "prompt_cache_hit_tokens": 0, "prompt_cache_miss_tokens": 0, "cost_usd": 0.0}
        for d in sorted(os.listdir(SESSIONS_DIR)):
            if d in ("active", "current"):
                continue
            usage_path = os.path.join(SESSIONS_DIR, d, "usage.jsonl")
            if not os.path.isfile(usage_path):
                continue
            sess_cost = 0.0
            sess_turns = 0
            with open(usage_path) as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        rec = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if rec.get("total"):
                        continue
                    sess_turns += 1
                    sess_cost += rec.get("cost_usd", 0)
                    for k in grand:
                        if k != "cost_usd":
                            grand[k] += rec.get(k, 0)
                    grand["cost_usd"] += rec.get("cost_usd", 0)
            if sess_turns:
                meta_path = os.path.join(SESSIONS_DIR, d, "meta.json")
                title = d
                if os.path.isfile(meta_path):
                    try:
                        with open(meta_path) as f:
                            meta = json.load(f)
                        title = meta.get("title") or d
                    except (json.JSONDecodeError, OSError):
                        pass
                print(f"  {title}: {sess_turns} turns, ${sess_cost:.4f}")
        if grand["cost_usd"] > 0:
            hit_pct = (grand["prompt_cache_hit_tokens"] / max(1, grand["prompt_tokens"])) * 100
            print(f"\n  TOTAL: ${grand['cost_usd']:.4f}  "
                  f"({grand['prompt_tokens']:,} prompt, {grand['completion_tokens']:,} completion, "
                  f"{hit_pct:.0f}% cache hit)")
        else:
            print("No usage data found.")
        sys.exit(0)

    # --resume: fuzzy-match a session title and load it
    if args.resume is not None:
        if not os.path.isdir(SESSIONS_DIR):
            print("No sessions found.", file=sys.stderr)
            sys.exit(1)
        query = args.resume.lower()
        matches = []
        for d in sorted(os.listdir(SESSIONS_DIR)):
            if d in ("active", "current"):
                continue
            meta_path = os.path.join(SESSIONS_DIR, d, "meta.json")
            if os.path.isfile(meta_path):
                try:
                    with open(meta_path) as f:
                        meta = json.load(f)
                    title = meta.get("title") or ""
                    if query in title.lower():
                        matches.append((d, title, meta.get("created", "?")))
                except (json.JSONDecodeError, OSError):
                    pass
        if not matches:
            print(f"No sessions matching '{args.resume}'.", file=sys.stderr)
            sys.exit(1)
        if len(matches) > 1 and not sys.stdin.isatty():
            print(f"Multiple sessions matching '{args.resume}':", file=sys.stderr)
            for d, title, created in matches:
                print(f"  {d}  {created}  {title}", file=sys.stderr)
            sys.exit(1)
        if len(matches) > 1:
            print(f"Multiple sessions matching '{args.resume}':", file=sys.stderr)
            for idx, (d, title, created) in enumerate(matches):
                print(f"  [{idx}] {d}  {created}  {title}", file=sys.stderr)
            try:
                choice = input(f"Pick [0-{len(matches)-1}]: ").strip()
                pick = int(choice)
                if pick < 0 or pick >= len(matches):
                    raise ValueError
            except (ValueError, EOFError, KeyboardInterrupt):
                print("Cancelled.", file=sys.stderr)
                sys.exit(1)
        else:
            pick = 0
        sess_dir = os.path.join(SESSIONS_DIR, matches[pick][0])
        name = matches[pick][1] or matches[pick][0]
        existing = _find_active_sessions(name)
        if existing:
            symlink_name = existing[0][0]
        else:
            symlink_name = _create_active_symlink(sess_dir, name)
        _apply_session_dir(args, sess_dir, symlink_name)
        print(f"[ds] resumed: {matches[pick][1]}", file=sys.stderr)

    # --fork: fork/clone the current session (runs before _resolve_persist)
    if args.fork is not None:
        src_session = args.session
        if not src_session:
            ds_session = os.environ.get("DS_SESSION", "")
            if ds_session:
                link_path = os.path.join(ACTIVE_DIR, ds_session)
                if os.path.islink(link_path):
                    src_session = os.path.join(os.path.realpath(link_path), "session.jsonl")
        if not src_session or not os.path.isfile(src_session):
            print("Error: --fork requires --session or an active persistent session.",
                  file=sys.stderr)
            sys.exit(1)
        messages = load_session(src_session)
        cut = args.fork
        if cut == -1:
            cut = len(messages)
        elif cut < 0:
            cut = max(0, len(messages) + cut)
        else:
            cut = cut + 1
        if cut > len(messages):
            cut = len(messages)

        new_id = _session_id()
        new_dir = os.path.join(SESSIONS_DIR, new_id)
        os.makedirs(new_dir, exist_ok=True)

        src_dir = os.path.dirname(src_session)
        src_meta_path = os.path.join(src_dir, "meta.json")
        new_meta = {}
        if os.path.isfile(src_meta_path):
            try:
                with open(src_meta_path) as f:
                    new_meta = json.load(f)
            except (json.JSONDecodeError, OSError):
                pass
        fork_title = args.title or new_meta.get("title", "untitled")
        new_meta["title"] = f"{fork_title} (fork@{cut})"
        new_meta["created"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        new_meta["forked_from"] = {"session": src_session, "at_turn": cut}
        with open(os.path.join(new_dir, "meta.json"), "w") as f:
            json.dump(new_meta, f, indent=2)

        new_session_path = os.path.join(new_dir, "session.jsonl")
        with open(new_session_path, "w") as f:
            for msg in messages[:cut]:
                f.write(json.dumps(msg) + "\n")

        fork_name = new_meta.get("title", new_id)
        symlink_name = _create_active_symlink(new_dir, fork_name)
        os.environ["DS_SESSION"] = symlink_name

        print(f"[ds] forked {cut}/{len(messages)} turns → {new_id}", file=sys.stderr)
        if args.title:
            print(f"[ds] title: {fork_title} (fork@{cut})", file=sys.stderr)
        sys.exit(0)

    # Resolve persistent session dirs (must run before other arg post-processing)
    _resolve_persist(args)

    # Guard: MCP without persistence is data loss
    if args.mcp and not args.session:
        print("Error: --mcp requires a session file (--session or --persist).\n"
              "Without persistence, the entire tool call chain is lost the moment\n"
              "the process exits — success or failure. Add --session <file> or --persist.",
              file=sys.stderr)
        sys.exit(1)

    # Guard: max-turns too low is almost always a mistake
    if args.max_turns is not None and args.max_turns < 20:
        print(f"Error: --max-turns {args.max_turns} is too low (minimum 20).\n"
              "Low turn limits cause workers to abort mid-task. If you really meant\n"
              "single-shot inference, omit --max-turns entirely.",
              file=sys.stderr)
        sys.exit(1)

    # Guard: max-turns without MCP is meaningless
    if args.max_turns and not args.mcp:
        print("Error: --max-turns requires --mcp.\n"
              "Without MCP tools there's no agent loop to bound.",
              file=sys.stderr)
        sys.exit(1)

    # Warn: zero observability
    if args.quiet and not args.session and args.no_stream:
        print("Warning: -q with no session and no streaming = zero visibility.\n"
              "Consider adding --session to preserve tool call history.",
              file=sys.stderr)

    # --show-turn: print turn(s) from the session and exit
    if args.show_turn is not None:
        if not args.session:
            print("Error: --show-turn requires --session or an active persistent session.",
                  file=sys.stderr)
            sys.exit(1)
        messages = load_session(args.session)
        total = len(messages)
        spec = args.show_turn
        try:
            if ":" in spec:
                parts = spec.split(":", 1)
                start = int(parts[0]) if parts[0] else 0
                end = int(parts[1]) if parts[1] else total
                if start < 0:
                    start = max(0, total + start)
                if end < 0:
                    end = max(0, total + end)
                selected = list(range(start, min(end, total)))
            else:
                n = int(spec)
                if n < 0:
                    n = total + n
                selected = [n]
        except ValueError:
            print(f"Error: invalid turn spec '{spec}'. Use N, N:M, or -N.", file=sys.stderr)
            sys.exit(1)
        for i in selected:
            if 0 <= i < total:
                print(f"--- turn {i} ({messages[i].get('role', '?')}) ---")
                print(json.dumps(messages[i], indent=2))
            else:
                print(f"Error: turn {i} out of range (session has {total} turns, 0-indexed).",
                      file=sys.stderr)
                sys.exit(1)
        sys.exit(0)

    # --grep-session: search session turns for a pattern
    if args.grep_session is not None:
        if not args.session:
            print("Error: --grep-session requires --session or an active persistent session.",
                  file=sys.stderr)
            sys.exit(1)
        import re
        messages = load_session(args.session)
        try:
            pattern = re.compile(args.grep_session, re.IGNORECASE)
        except re.error as e:
            print(f"Error: invalid regex: {e}", file=sys.stderr)
            sys.exit(1)
        field = args.grep_field or "content"
        found = False
        for i, msg in enumerate(messages):
            val = msg.get(field, "")
            if val is None:
                val = ""
            if isinstance(val, list):
                val = " ".join(str(c) for c in val)
            if pattern.search(val):
                role = msg.get("role", "?")
                preview = val[:120].replace("\n", " ")
                print(f"  [{i}] {role}: {preview}")
                found = True
        if not found:
            print("No matches.")
        sys.exit(0)

    # --session-info: print session summary
    if args.session_info:
        if not args.session:
            print("Error: --session-info requires --session or an active persistent session.",
                  file=sys.stderr)
            sys.exit(1)
        messages = load_session(args.session)
        roles = {}
        total_chars = 0
        for msg in messages:
            role = msg.get("role", "unknown")
            roles[role] = roles.get(role, 0) + 1
            content = msg.get("content", "")
            if isinstance(content, list):
                content = " ".join(str(c) for c in content)
            total_chars += len(content)
        print(f"  session: {args.session}")
        print(f"  turns:   {len(messages)}")
        print(f"  chars:   {total_chars} (~{total_chars // 3} tokens est.)")
        print(f"  roles:   {', '.join(f'{r}: {c}' for r, c in sorted(roles.items()))}")
        sys.exit(0)

    # --inject: add a message to the session and exit
    if args.inject is not None:
        if not args.session:
            print("Error: --inject requires --session or an active persistent session.", file=sys.stderr)
            sys.exit(1)
        msg = {"role": args.inject_role, "content": args.inject}
        if args.name:
            msg["name"] = args.name
        append_session(args.session, msg)
        print(f"[ds] injected {args.inject_role} message into {args.session}", file=sys.stderr)
        sys.exit(0)

    # --system / --system-file override
    if args.system_file:
        try:
            with open(args.system_file) as f:
                args._system_prompt = f.read()
        except FileNotFoundError:
            print(f"Error: system prompt file not found: {args.system_file}", file=sys.stderr)
            sys.exit(1)
    elif args.system:
        args._system_prompt = args.system
    else:
        args._system_prompt = SYSTEM_PROMPT

    # --timeout validation
    if args.timeout is not None:
        if args.timeout > 600:
            print("Error: timeout > 600s is pointless — DeepSeek won't produce output "
                  "after 10 minutes have passed.", file=sys.stderr)
            sys.exit(1)
        thinking_on = args.think != "off"
        if thinking_on and args.timeout < 30:
            print("Error: timeout < 30s with thinking enabled — give it a chance.",
                  file=sys.stderr)
            sys.exit(1)
        if not thinking_on and args.timeout < 5:
            print("Error: timeout < 5s — give it a chance.", file=sys.stderr)
            sys.exit(1)

    # --top-logprobs implies --logprobs
    if args.top_logprobs is not None:
        args.logprobs = True
        if args.top_logprobs < 0 or args.top_logprobs > 20:
            print(f"Error: --top-logprobs must be 0-20, got {args.top_logprobs}.",
                  file=sys.stderr)
            sys.exit(1)

    # --stop max 16 sequences
    if len(args.stop) > 16:
        print(f"Error: --stop supports at most 16 sequences, got {len(args.stop)}.",
              file=sys.stderr)
        sys.exit(1)

    # --max-tokens ceiling
    if args.max_tokens is not None and args.max_tokens > 384_000:
        print(f"Error: --max-tokens max is 384000, got {args.max_tokens}.",
              file=sys.stderr)
        sys.exit(1)

    # --prefix implies --beta
    if args.prefix:
        args.beta = True

    # RE2 implies thinking off (re-reading replaces reasoning)
    if args.re2:
        if args.think in ("high", "max"):
            print(f"Error: --re2 and --think {args.think} are incompatible — "
                  f"RE2 re-reading replaces chain-of-thought reasoning.",
                  file=sys.stderr)
            sys.exit(1)
        if args.think is None or args.think == "auto":
            args.think = "off"

    # MCP requires thinking — auto-upgrade if off
    if args.mcp and args.think == "off":
        args.think = "high"
        print("Note: --think off upgraded to --think high — DeepSeek requires "
              "thinking for tool use.", file=sys.stderr)

    # Thinking mode silently ignores temperature and top_p — fail loud
    thinking_on = args.think != "off"
    if thinking_on and args.temperature is not None:
        print(f"Error: --temperature has no effect with thinking enabled — "
              f"DeepSeek silently ignores it. Use --think off to control temperature.",
              file=sys.stderr)
        sys.exit(1)
    if thinking_on and args.top_p is not None:
        print(f"Error: --top-p has no effect with thinking enabled — "
              f"DeepSeek silently ignores it. Use --think off to control top-p.",
              file=sys.stderr)
        sys.exit(1)

    # Thinking + tool_choice = API rejects
    if thinking_on and args.tool_choice:
        print(f"Error: --tool-choice has no effect with thinking enabled — "
              f"DeepSeek rejects tool_choice in thinking mode. "
              f"Use --think off to control tool choice.",
              file=sys.stderr)
        sys.exit(1)

    # Thinking + low max_tokens = broken output
    if args.max_tokens is not None and thinking_on and args.max_tokens < 100_000:
        print(f"Error: --max-tokens {args.max_tokens} is too low with thinking enabled. "
              f"Thinking tokens count against max_tokens and will starve the response. "
              f"Use at least 100000, or omit --max-tokens entirely.",
              file=sys.stderr)
        sys.exit(1)

    # Validate user_id format
    if args.user_id is not None:
        import re as _re
        if not _re.match(r'^[a-zA-Z0-9_-]+$', args.user_id):
            print(f"Error: --user-id '{args.user_id}' contains invalid characters. "
                  f"Only [a-zA-Z0-9_-] allowed.",
                  file=sys.stderr)
            sys.exit(1)
        if len(args.user_id) > 512:
            print(f"Error: --user-id is {len(args.user_id)} chars (max 512).",
                  file=sys.stderr)
            sys.exit(1)

    # No-task guard: if there's nothing to send to the API, exit cleanly.
    # This catches admin-only invocations like --persist off/no that don't sys.exit().
    # Eagerly consume stdin here so we know if there's actual piped content.
    args._stdin_content = None
    if not sys.stdin.isatty():
        _raw = sys.stdin.read().strip()
        if _raw:
            args._stdin_content = _raw
    has_task = args.task or args.context or args._stdin_content
    has_session = args.session and os.path.isfile(args.session)
    if not has_task and not has_session:
        sys.exit(0)

    _opened: list = []
    def _open_out(path: str | None):
        if path is None:
            return sys.stdout
        fh = open(path, "w")
        _opened.append(fh)
        return fh

    content_out = _open_out(args.out)
    if args.quiet and not args.think_out:
        think_out = open(os.devnull, "w")
        _opened.append(think_out)
    else:
        think_out = _open_out(args.think_out)
    raw_out = _open_out(args.raw) if args.raw else None
    # Auto-save usage into session dir when persisting
    if args.usage_out:
        usage_out = _open_out(args.usage_out)
    elif args.session:
        sess_dir = os.path.dirname(args.session)
        usage_path = os.path.join(sess_dir, "usage.jsonl")
        usage_out = open(usage_path, "a")
        _opened.append(usage_out)
    else:
        usage_out = None

    asyncio.run(async_main(args, content_out, think_out, raw_out, usage_out, _opened))


if __name__ == "__main__":
    main()
