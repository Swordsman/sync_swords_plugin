def load_api_key() -> str:
    env_key = os.environ.get("DEEPSEEK_API_KEY", "")
    if env_key:
        return env_key
    try:
        spec = importlib.util.spec_from_file_location(
            "keyfetch", os.path.expanduser("~/keyfetch.py")
        )
        if spec and spec.loader:
            keyfetch = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(keyfetch)
            return keyfetch.get_secret("DEEPSEEK")
    except Exception as e:
        print(f"Error: keyfetch failed ({e}) and $DEEPSEEK_API_KEY not set",
              file=sys.stderr)
        sys.exit(1)
    print("Error: $DEEPSEEK_API_KEY not set and ~/keyfetch.py not found",
          file=sys.stderr)
    sys.exit(1)


def load_session(path: str) -> list[dict]:
    messages = []
    if os.path.exists(path):
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line:
                    messages.append(json.loads(line))
    return messages


def append_session(path: str, message: dict) -> None:
    with open(path, "a") as f:
        f.write(json.dumps(message) + "\n")


SESSIONS_DIR = os.path.expanduser(os.environ.get("DS_SESSIONS_DIR", "~/.local/share/ds/sessions"))


def _session_id() -> str:
    """Centisecond UTC timestamp as zero-padded hex — sortable, unique on a single system."""
    return f"{int(time.time() * 100):013x}"


ACTIVE_DIR = os.path.join(SESSIONS_DIR, "active")


def _generate_salt(length: int = 4) -> str:
    return os.urandom(length).hex()[:length]


def _find_active_sessions(name: str) -> list[tuple[str, str]]:
    """Find active symlinks matching a bare name. Returns [(symlink_name, sess_dir), ...]."""
    if not os.path.isdir(ACTIVE_DIR):
        return []
    results = []
    for entry in os.listdir(ACTIVE_DIR):
        link_path = os.path.join(ACTIVE_DIR, entry)
        if not os.path.islink(link_path):
            continue
        target = os.path.realpath(link_path)
        if not os.path.isdir(target):
            continue
        bare = entry.rsplit(".", 1)[0] if "." in entry else entry
        if bare == name:
            results.append((entry, target))
    return results


def _create_active_symlink(sess_dir: str, name: str) -> str:
    """Create a salted symlink in active/ pointing to sess_dir. Returns the symlink name."""
    os.makedirs(ACTIVE_DIR, exist_ok=True)
    symlink_name = f"{name}.{_generate_salt()}"
    link_path = os.path.join(ACTIVE_DIR, symlink_name)
    tmp_link = link_path + ".tmp"
    os.symlink(sess_dir, tmp_link)
    os.rename(tmp_link, link_path)
    return symlink_name


def _remove_active_symlink(symlink_name: str) -> None:
    """Remove a symlink from active/."""
    link_path = os.path.join(ACTIVE_DIR, symlink_name)
    try:
        os.remove(link_path)
    except FileNotFoundError:
        pass


def _resolve_persist(args) -> None:
    """Resolve --persist / --title / DS_SESSION into args.session.

    Session tracking uses active/ folder with named symlinks and DS_SESSION env var,
    replacing the old single 'current' symlink.
    """
    persist = args.persist
    if persist in ("no", "n"):
        return

    if persist == "off":
        os.environ.pop("DS_SESSION", None)
        return

    # --persist <name> (free-form string, not yes/no/on/off)
    if persist and persist not in ("yes", "y", "on"):
        name = persist
        # Check active symlinks first
        matches = _find_active_sessions(name)
        if len(matches) == 1:
            _apply_session_dir(args, matches[0][1], matches[0][0])
            return
        elif len(matches) > 1:
            print(f"Multiple active sessions named '{name}':", file=sys.stderr)
            for symname, target in sorted(matches):
                print(f"  {symname} -> {target}", file=sys.stderr)
            print("Use --session to target one directly.", file=sys.stderr)
            sys.exit(1)
        # No active symlink — search session dirs by meta.json name/title
        if os.path.isdir(SESSIONS_DIR):
            dir_matches = []
            for d in os.listdir(SESSIONS_DIR):
                if d in ("active", "current"):
                    continue
                meta_path = os.path.join(SESSIONS_DIR, d, "meta.json")
                if os.path.isfile(meta_path):
                    try:
                        with open(meta_path) as f:
                            meta = json.load(f)
                        if meta.get("name") == name or meta.get("title") == name:
                            dir_matches.append(d)
                    except (json.JSONDecodeError, OSError):
                        pass
            if len(dir_matches) == 1:
                sess_dir = os.path.join(SESSIONS_DIR, dir_matches[0])
                symlink_name = _create_active_symlink(sess_dir, name)
                _apply_session_dir(args, sess_dir, symlink_name)
                return
            elif len(dir_matches) > 1:
                print(f"Multiple sessions named '{name}':", file=sys.stderr)
                for m in sorted(dir_matches):
                    print(f"  {m}", file=sys.stderr)
                print("Use --session to target one directly.", file=sys.stderr)
                sys.exit(1)
        # No match anywhere — create new session
        sess_id = _session_id()
        sess_dir = os.path.join(SESSIONS_DIR, sess_id)
        os.makedirs(sess_dir, exist_ok=True)
        meta = {"name": name, "title": args.title, "created": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                "args": _serialize_sticky_args(args)}
        with open(os.path.join(sess_dir, "meta.json"), "w") as f:
            json.dump(meta, f, indent=2)
        symlink_name = _create_active_symlink(sess_dir, name)
        _apply_session_dir(args, sess_dir, symlink_name)
        return

    if persist in ("yes", "y", "on"):
        # --title search across all session dirs
        if args.title and os.path.exists(SESSIONS_DIR):
            matches = []
            for d in os.listdir(SESSIONS_DIR):
                if d in ("active", "current"):
                    continue
                meta_path = os.path.join(SESSIONS_DIR, d, "meta.json")
                if os.path.isfile(meta_path):
                    try:
                        with open(meta_path) as f:
                            meta = json.load(f)
                        if meta.get("title") == args.title:
                            matches.append(d)
                    except (json.JSONDecodeError, OSError):
                        pass
            if len(matches) == 1:
                sess_dir = os.path.join(SESSIONS_DIR, matches[0])
                name = args.title or matches[0]
                existing = _find_active_sessions(name)
                if existing:
                    _apply_session_dir(args, sess_dir, existing[0][0])
                else:
                    symlink_name = _create_active_symlink(sess_dir, name)
                    _apply_session_dir(args, sess_dir, symlink_name)
                return
            elif len(matches) > 1:
                print(f"Multiple sessions titled '{args.title}':", file=sys.stderr)
                for m in sorted(matches):
                    print(f"  {m}", file=sys.stderr)
                print("Use --session to target one directly.", file=sys.stderr)
                sys.exit(1)

        sess_id = _session_id()
        sess_dir = os.path.join(SESSIONS_DIR, sess_id)
        os.makedirs(sess_dir, exist_ok=True)
        name = args.title or sess_id
        meta = {"name": name, "title": args.title, "created": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                "args": _serialize_sticky_args(args)}
        with open(os.path.join(sess_dir, "meta.json"), "w") as f:
            json.dump(meta, f, indent=2)
        symlink_name = _create_active_symlink(sess_dir, name)
        _apply_session_dir(args, sess_dir, symlink_name)
        return

    # No --persist flag: check DS_SESSION env var for auto-resume
    if persist is None and args.session is None:
        ds_session = os.environ.get("DS_SESSION", "")
        if ds_session:
            link_path = os.path.join(ACTIVE_DIR, ds_session)
            if os.path.islink(link_path):
                sess_dir = os.path.realpath(link_path)
                if os.path.isdir(sess_dir):
                    _apply_session_dir(args, sess_dir, ds_session)


def _apply_session_dir(args, sess_dir: str, symlink_name: str) -> None:
    """Point args.session at the dir's session.jsonl, apply sticky args, set DS_SESSION."""
    args.session = os.path.join(sess_dir, "session.jsonl")

    meta_path = os.path.join(sess_dir, "meta.json")
    if os.path.isfile(meta_path):
        try:
            with open(meta_path) as f:
                meta = json.load(f)
            sticky = meta.get("args", {})
            _SKIP_STICKY = {"task", "session", "persist", "title"}
            for key, val in sticky.items():
                if key in _SKIP_STICKY:
                    continue
                current = getattr(args, key, None)
                if current is None or current is False or current == []:
                    setattr(args, key, val)
        except (json.JSONDecodeError, OSError):
            pass

    os.environ["DS_SESSION"] = symlink_name


_STICKY_ARGS = ("model", "think", "temperature", "top_p", "max_tokens", "max_turns",
                "re2", "mcp", "mcp_config", "no_stream", "quiet", "guarantee_json_output",
                "timeout", "logprobs", "top_logprobs", "stop", "user_id", "beta", "name")


def _serialize_sticky_args(args) -> dict:
    """Extract CLI args worth persisting."""
    result = {}
    for key in _STICKY_ARGS:
        val = getattr(args, key, None)
        if val is not None and val != [] and val is not False:
            result[key] = val
    return result


def _quick_inference(prompt: str, system: str = "You are a concise assistant.", model: str = "flash") -> str:
    """Fire a cheap call for internal meta-tasks (titling, summarizing, etc.)."""
    import subprocess
    result = subprocess.run(
        ["ds", "--persist", "no", "--think", "off", "-q", "--no-stream", "-m", model,
         "--system", system, prompt],
        capture_output=True, text=True,
    )
    return result.stdout.strip()


def _auto_title_session(session_path: str, first_user_msg: str, model: str = "flash") -> None:
    """Generate a title for an untitled session from the first user message."""
    sess_dir = os.path.dirname(session_path)
    meta_path = os.path.join(sess_dir, "meta.json")
    if not os.path.isfile(meta_path):
        return
    try:
        with open(meta_path) as f:
            meta = json.load(f)
    except (json.JSONDecodeError, OSError):
        return
    if meta.get("title"):
        return
    preview = first_user_msg[:500]
    title = _quick_inference(
        f"Generate a short title (3-6 words, no quotes, no punctuation) for a session "
        f"that starts with this message:\n\n{preview}",
        system="You generate short descriptive titles. Return ONLY the title, nothing else.",
        model=model,
    )
    if title:
        meta["title"] = title
        with open(meta_path, "w") as f:
            json.dump(meta, f, indent=2)
        print(f"[ds] auto-titled: {title}", file=sys.stderr)


def build_extra_kwargs(think: str | None) -> dict:
    """Build extra API kwargs based on --think level.

    None/auto → no override (DeepSeek default, auto-selects effort)
    "off"     → disable thinking
    "high"    → explicit high effort
    "max"     → max effort
    """
    if think == "off":
        return {"extra_body": {"thinking": {"type": "disabled"}}}
    if think == "max":
        return {
            "extra_body": {"thinking": {"type": "enabled"}},
            "reasoning_effort": "max",
        }
    if think == "high":
        return {
            "extra_body": {"thinking": {"type": "enabled"}},
            "reasoning_effort": "high",
        }
    return {}


def _idle_timeout_iter(response_iter, timeout_secs):
    """Wrap a streaming response iterator with an idle timeout that resets on each chunk."""
    import threading
    import queue

    q = queue.Queue()
    _DONE = object()

    def _reader():
        try:
            for chunk in response_iter:
                q.put(chunk)
        except Exception as e:
            q.put(e)
        finally:
            q.put(_DONE)

    t = threading.Thread(target=_reader, daemon=True)
    t.start()

    while True:
        try:
            item = q.get(timeout=timeout_secs)
        except queue.Empty:
            raise TimeoutError(f"No data received from API for {timeout_secs}s")
        if item is _DONE:
            return
        if isinstance(item, Exception):
            raise item
        yield item


def _extract_usage(raw) -> dict:
    """Extract usage dict from an API response or final streaming chunk."""
    usage = getattr(raw, "usage", None)
    if usage is None:
        return {}
    u = {}
    u["prompt_tokens"] = getattr(usage, "prompt_tokens", 0) or 0
    u["completion_tokens"] = getattr(usage, "completion_tokens", 0) or 0
    u["total_tokens"] = getattr(usage, "total_tokens", 0) or 0
    details = getattr(usage, "completion_tokens_details", None)
    u["reasoning_tokens"] = getattr(details, "reasoning_tokens", 0) or 0 if details else 0
    u["prompt_cache_hit_tokens"] = getattr(usage, "prompt_cache_hit_tokens", 0) or 0
    u["prompt_cache_miss_tokens"] = getattr(usage, "prompt_cache_miss_tokens", 0) or 0
    return u


def _estimate_cost(usage: dict, model: str) -> float | None:
    """Estimate cost in USD from a usage dict."""
    rates = _PRICING.get(model)
    if not rates or not usage:
        return None
    hit = usage.get("prompt_cache_hit_tokens", 0)
    miss = usage.get("prompt_cache_miss_tokens", 0)
    out = usage.get("completion_tokens", 0)
    return (hit * rates["cache_hit"] + miss * rates["cache_miss"] + out * rates["output"]) / 1_000_000


def _resolve_tool_choice(choice: str, tool_schemas: list[dict]) -> str | dict:
    if choice in ("none", "auto", "required"):
        return choice
    available = {s["function"]["name"] for s in tool_schemas} if tool_schemas else set()
    if choice not in available:
        print(f"Error: --tool-choice '{choice}' not found in available tools: "
              f"{', '.join(sorted(available)) or '(none)'}",
              file=sys.stderr)
        sys.exit(1)
    return {"type": "function", "function": {"name": choice}}


def stream_response(response, content_out, think_out, raw_out=None) -> tuple[str, str, list[dict], dict, str | None]:
    """Stream a response, routing content and thinking to their streams.

    Returns (content, reasoning_content, tool_calls, usage, finish_reason).
    """
    collected_content: list[str] = []
    collected_thinking: list[str] = []
    tool_calls_raw: dict[int, dict] = {}
    in_thinking = False
    usage = {}
    finish_reason = None

    for chunk in response:
        if raw_out is not None:
            print(json.dumps(chunk.model_dump()), file=raw_out, flush=True)

        chunk_usage = _extract_usage(chunk)
        if chunk_usage:
            usage = chunk_usage

        if not chunk.choices:
            continue

        choice = chunk.choices[0]
        if choice.finish_reason:
            finish_reason = choice.finish_reason
        delta = choice.delta

        if hasattr(delta, "reasoning_content") and delta.reasoning_content:
            if not in_thinking:
                print("[thinking]", file=think_out, flush=True)
            print(delta.reasoning_content, end="", file=think_out, flush=True)
            collected_thinking.append(delta.reasoning_content)
            in_thinking = True
            continue

        if delta.tool_calls:
            for tc in delta.tool_calls:
                idx = tc.index
                if idx not in tool_calls_raw:
                    tool_calls_raw[idx] = {"id": "", "name": "", "arguments": ""}
                if tc.id:
                    tool_calls_raw[idx]["id"] = tc.id
                if tc.function.name:
                    tool_calls_raw[idx]["name"] = tc.function.name
                if tc.function.arguments:
                    tool_calls_raw[idx]["arguments"] += tc.function.arguments
            continue

        if delta.content:
            if in_thinking:
                print(file=think_out)
            in_thinking = False
            collected_content.append(delta.content)
            print(delta.content, end="", file=content_out, flush=True)

    if collected_content:
        print(file=content_out)

    tool_calls = [
        {"id": v["id"], "name": v["name"], "arguments": v["arguments"]}
        for v in tool_calls_raw.values()
    ]
    return "".join(collected_content), "".join(collected_thinking), tool_calls, usage, finish_reason


def handle_response_sync(response, content_out, think_out, raw_out=None) -> tuple[str, str, list[dict], dict, str | None]:
    """Handle a non-streaming response. Returns (content, reasoning_content, tool_calls, usage, finish_reason)."""
    if raw_out is not None:
        print(json.dumps(response.model_dump()), file=raw_out, flush=True)

    usage = _extract_usage(response)
    finish_reason = response.choices[0].finish_reason

    msg = response.choices[0].message
    content = msg.content or ""
    thinking = getattr(msg, "reasoning_content", None) or ""

    if thinking:
        print("[thinking]", file=think_out, flush=True)
        print(thinking, file=think_out, flush=True)
    if content:
        print(content, file=content_out, flush=True)

    tool_calls = []
    if msg.tool_calls:
        for tc in msg.tool_calls:
            tool_calls.append({
                "id": tc.id,
                "name": tc.function.name,
                "arguments": tc.function.arguments,
            })

    return content, thinking, tool_calls, usage, finish_reason


