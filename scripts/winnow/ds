#!/usr/bin/env python3
"""DeepSeek agent / write worker.

Single-shot (default):
  ds "write a Python function that does X"
  ds "rewrite this to do Y" --context /path/to/file
  cat file.py | ds "add type annotations to every function"
  ds "task" --think=off            # disable thinking entirely
  ds "task" --think=max            # force max reasoning effort

Session (manual or auto-loop) mode:
  ds --session /tmp/s.jsonl "explore the repo"   # start or continue a session
  ds --session /tmp/s.jsonl                       # continue without new user message

MCP tools:
  ds --mcp "serena start-mcp-server --project ." "find all test files"
  ds --mcp serena --session /tmp/s.jsonl "explore the repo"

RE2 (re-reading for non-reasoning quality boost):
  ds --re2 paper "complex task"           # paper-style, implies --think off
  ds --re2 xml "complex task"            # xml-tagged variant with phase metadata

Output routing (all default to stdout; use /dev/null to silence):
  ds "task" --out /tmp/result.txt
  ds "task" --think-out /dev/null
  ds "task" --think-out /tmp/thinking.txt --out /tmp/answer.txt
"""

