def apply_re2(user_content: str, variant: str = "paper") -> str:
    if variant == "paper":
        return f"```Q:\n{user_content}\n```\n\nRead the question again:\n\n```Q:\n{user_content}\n```\n\n```A:"
    if variant == "xml":
        return (
            f"<RE2 phase='init1'>{_RE2_INIT_TEXT}</RE2>\n"
            f"<RE2 phase='init2'>{_RE2_INIT_TEXT}</RE2>\n"
            # f"Now here are your actual instructions:\n"
            f"<RE2 phase='task1'>{user_content}</RE2>\n"
            # f"Now here are your actual instructions again:\n"
            f"<RE2 phase='task2'>{user_content}</RE2>\n"
        )
    raise ValueError(f"Unknown RE2 variant: {variant!r}")


