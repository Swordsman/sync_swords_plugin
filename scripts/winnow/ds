    def has_json_object(text: str) -> bool:
        """Check if text contains a JSON object example (via jsonfinder)."""
        return _has_json(text)
except ImportError:
    def has_json_object(text: str) -> bool:
        """Check if text contains a JSON object example (via raw_decode fallback)."""
        decoder = json.JSONDecoder()
        i = 0
        while i < len(text):
            idx = text.find('{', i)
            if idx == -1:
                return False
            try:
                obj, end = decoder.raw_decode(text, idx)
                if isinstance(obj, dict):
                    return True
            except (json.JSONDecodeError, ValueError):
                pass
            i = idx + 1
        return False


