#!/usr/bin/env python3
"""
xylem-shell — send commands to xylem's xonsh and get output back.

Connects to the xylem WebSocket terminal, sends a command, waits for
the prompt to return, then captures and prints the output.

Usage:
    xylem-shell "ls -la"                    # run a command
    xylem-shell --daemon                    # start persistent shell
    xylem-shell --send "echo hello"         # send to running daemon
"""
import asyncio, sys, os, re, time
import websockets

XYLEM_WS = os.environ.get('XYLEM_WS', 'ws://localhost:8643/ws')
SOCKET_PATH = os.path.expanduser('~/.xylem-shell.sock')

async def run_command(cmd: str, timeout: float = 30) -> str:
    """Connect to xylem, run a command, return captured output."""
    async with websockets.connect(XYLEM_WS) as ws:
        # Wait for initial prompt
        await asyncio.sleep(0.5)

        # Drain any buffered initial output
        try:
            while True:
                raw = await asyncio.wait_for(ws.recv(), timeout=0.3)
        except asyncio.TimeoutError:
            pass

        # Send the command
        await ws.send(cmd.encode() + b'\r')

        # Collect output until we see a prompt pattern
        output = b''
        start = time.time()
        while time.time() - start < timeout:
            try:
                raw = await asyncio.wait_for(ws.recv(), timeout=0.5)
                output += raw if isinstance(raw, bytes) else raw.encode()
            except asyncio.TimeoutError:
                break

        # Strip ANSI escape sequences for readability
        text = output.decode('utf-8', errors='replace')
        text = re.sub(r'\x1b\[[0-9;]*[a-zA-Z]', '', text)
        text = re.sub(r'\x1b\][0-9;]*[^\x07]*\x07', '', text)
        text = re.sub(r'\r', '', text)

        # Deduplicate consecutive blank lines
        lines = text.split('\n')
        clean = []
        prev_blank = False
        for line in lines:
            is_blank = not line.strip()
            if is_blank and prev_blank:
                continue
            clean.append(line)
            prev_blank = is_blank

        return '\n'.join(clean)

async def daemon_mode():
    """Run a persistent shell, accepting commands via Unix socket."""
    if os.path.exists(SOCKET_PATH):
        os.unlink(SOCKET_PATH)

    async with websockets.connect(XYLEM_WS) as ws:
        async def handle_client(reader, writer):
            data = await reader.read(65536)
            cmd = data.decode().strip()
            await ws.send(cmd.encode() + b'\r')
            await asyncio.sleep(0.3)
            output = b''
            try:
                while True:
                    raw = await asyncio.wait_for(ws.recv(), timeout=1.0)
                    output += raw if isinstance(raw, bytes) else raw.encode()
            except asyncio.TimeoutError:
                pass
            text = output.decode('utf-8', errors='replace')
            text = re.sub(r'\x1b\[[0-9;]*[a-zA-Z]', '', text)
            writer.write(text.encode())
            await writer.drain()
            writer.close()

        server = await asyncio.start_unix_server(handle_client, path=SOCKET_PATH)
        os.chmod(SOCKET_PATH, 0o600)
        print(f"xylem-shell daemon listening on {SOCKET_PATH}")
        await server.serve_forever()

async def send_to_daemon(cmd: str):
    """Send a command to the running daemon."""
    import socket
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.connect(SOCKET_PATH)
    sock.send(cmd.encode())
    sock.shutdown(socket.SHUT_WR)
    response = b''
    while True:
        chunk = sock.recv(4096)
        if not chunk:
            break
        response += chunk
    sock.close()
    print(response.decode())

if __name__ == '__main__':
    if len(sys.argv) < 2:
        print("Usage: xylem-shell <command>")
        print("       xylem-shell --daemon")
        print("       xylem-shell --send <command>")
        sys.exit(1)

    if sys.argv[1] == '--daemon':
        asyncio.run(daemon_mode())
    elif sys.argv[1] == '--send':
        cmd = ' '.join(sys.argv[2:])
        asyncio.run(send_to_daemon(cmd))
    else:
        cmd = ' '.join(sys.argv[1:])
        result = asyncio.run(run_command(cmd))
        print(result)
